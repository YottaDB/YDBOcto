#include "logical_plan.h"
#include "template_helpers.h"

TEMPLATE(tmpl_key_advance, PhysicalPlan *pplan, SqlKey *key) {
	char			*tableName;
	SqlValue		*value;
	SqlTable		*table;
	SqlOptionalKeyword	*keyword = NULL;
	unsigned int		iter_key_index = 0;
	int			keys_to_match = 0, hit_key = 0;
	char			*columnName = "";

	// If there is no table, this is a temporary key;
	//  use cursor to store the value
	if ((NULL == key->fixed_to_value) && (NULL == key->table)) {
		if (NULL != key->view_definition_output_key) {
			/* This is a key of a view. Iterate the result of the view definition. */
			SqlKey *view_src_output_key = key->view_definition_output_key->v.lp_key.key;
			%{}{{ config->global_names.cursor }}(cursorId,{{ PP_KEYS }},{}%
			%{}{{ view_src_output_key->unique_id|%d }},"","",{}%
		} else {
			%{}{{ config->global_names.cursor }}(cursorId,{{ PP_KEYS }},{{ key->unique_id|%d }},"","",{}%
		}
		TMPL(tmpl_key, key);
		%{}){}%
		return;
	}

	table = key->table;
	UNPACK_SQL_STATEMENT(value, table->tableName, value);
	tableName = value->v.reference;

	// We ignore the key value here, so we can check if there is data in this key in some cases
	if (key->cross_reference_output_key) {
		SqlKey	*iter_key;

		UNPACK_SQL_STATEMENT(value, key->cross_reference_output_key->column->columnName, value);
		columnName = value->v.reference;
		// Tables kept in local variables can't go through YDBAIM
		if ('^' == key->cross_reference_output_key->xref_prefix[0]) {
			TMPL(tmpl_key_source_aim, tableName, columnName);
		} else {
			%{}{{ key->cross_reference_output_key->xref_prefix }}{}%
			%{}{{ config->global_names.raw_xref }}("{{ tableName }}","{{ columnName }}"{}%
		}
		// Output the column this cross reference is sourced from
		iter_key_index = 0;
		while ((iter_key_index < pplan->total_iter_keys)
				&& (pplan->iterKeys[iter_key_index]->unique_id != key->unique_id)) {
			iter_key_index++;
		}
		iter_key = pplan->iterKeys[iter_key_index];
		while (iter_key_index < pplan->total_iter_keys) {
			if (iter_key->unique_id == key->unique_id)
				keys_to_match++;
			%{},{}%

			boolean_t	aimsub_needed;
			if ((NULL != iter_key->xref_prefix) && ('^' == iter_key->xref_prefix[0])
					&& (IS_COLUMN_STRING_TYPE(iter_key->column))) {
				aimsub_needed = TRUE;
				%{}$$strcolval2aimsubs^%%ydboctoplanhelpers({}%
			} else {
				aimsub_needed = FALSE;
			}
			if ((1 == keys_to_match) && IS_NULL_FIXED_VALUE(iter_key->fixed_to_value)) {
				/* Use empty string instead of $ZYSQLNULL when generating xref global subscript.
				 * This is because we use "" to store NULL values in the xref global.
				 * Cannot use $ZSYSQLNULL as a subscript (will issue ZYSQLNULLNOTVALID error).
				 */
				%{}""{}%
			} else {
				assert(!IS_NULL_FIXED_VALUE(iter_key->fixed_to_value));
				TMPL(tmpl_key, iter_key);
			}
			if (aimsub_needed) {
				%{}){}%
			}
			iter_key_index++;
			iter_key = pplan->iterKeys[iter_key_index];
			if (hit_key && (iter_key != key))
				break;
			if (iter_key == key)
				hit_key = TRUE;
		}
		%{}){}%
	} else {
		SqlKey	*plan_key;

		for (iter_key_index = 0; iter_key_index < pplan->total_iter_keys; iter_key_index++) {
			plan_key = pplan->iterKeys[iter_key_index];
			if (plan_key == key) {
				break;
			}
			if (plan_key->is_cross_reference_key) {
				continue;
			}
			if (plan_key->unique_id == key->unique_id)
				keys_to_match++;
		}
		keys_to_match++;
		keyword = get_keyword(key->column, OPTIONAL_ITERATOR);
		if (NULL != keyword) {
			char	*iterator;
			char	*paren;

			UNPACK_SQL_STATEMENT(value, keyword->v, value);
			iterator = value->v.string_literal;
			paren = strchr(iterator, '(');

			if (NULL == paren) {
				/* Bare entryref format "$$tag^routine": Octo appends every key of this
				 * unique_id automatically as comma-separated arguments.
				 */
				boolean_t first_key_emitted = FALSE;

				%{}{{ iterator }}({}%
				for (iter_key_index = 0; iter_key_index < pplan->total_iter_keys; iter_key_index++) {
					plan_key = pplan->iterKeys[iter_key_index];
					if (plan_key->unique_id == key->unique_id) {
						if (first_key_emitted) {
							%{},{}%
						}
						TMPL(tmpl_key, plan_key);
						first_key_emitted = TRUE;
						if (--keys_to_match == 0) break;
					}
				}
				assert(0 == keys_to_match);
				%{}){}%
			} else {
				/* Argument-list format "$$tag^routine(arglist)": emit the prefix up to
				 * and including the '(' verbatim, then walk the argument list
				 * substituting each keys("colname") token with a cursor lookup of that
				 * column's current key value (the same emission tmpl_emit_source.ctemplate
				 * uses for keys() in GLOBAL strings). Other bytes (literals, M
				 * expressions, commas) pass through unchanged. The trailing ')' is
				 * emitted as part of the verbatim pass.
				 *
				 * validate_iterator_keyword() has already verified that values() is
				 * absent and that every keys() names a KEY column of this table, so
				 * those branches are unreachable assertions below.
				 */
				char	*prefix_ptr;
				char	*arglist_start;
				char	*arglist_end;
				char	*ptr;

				for (prefix_ptr = iterator; prefix_ptr <= paren; prefix_ptr++) {
					%{}{{ *prefix_ptr|%c }}{}%
				}

				arglist_start = paren + 1;
				arglist_end   = iterator + strlen(iterator) - 1; /* Points at the trailing ')'. */
				ptr = arglist_start;
				while (ptr < arglist_end) {
					char			prev;
					char			column[OCTO_MAX_IDENT + 1];
					int			expr_len;
					ExpressionMatchType	match;

					prev  = (ptr == arglist_start) ? '(' : *(ptr - 1);
					match = match_expression(ptr, column, &expr_len, sizeof(column), prev);

					if (NoMatchExpression == match) {
						/* Opaque byte: pass through unchanged. */
						%{}{{ *ptr|%c }}{}%
						ptr++;
						continue;
					}

					assert(KeysExpression == match);
					assert(0 < expr_len);

					/* Emit the same cursor() call format used by tmpl_emit_source.ctemplate
					 * for keys() references in GLOBAL strings.
					 */
					%{}{{ config->global_names.cursor }}{}%
					%{}(cursorId,{{ PP_KEYS }},{{ key->unique_id|%d }},"{{ tableName }}","{{ column }}"){}%

					ptr += expr_len;
				}

				/* Emit the closing ')'. */
				%{}{{ *arglist_end|%c }}{}%
			}
		} else {
			assert(NULL != table->source);
			UNPACK_SQL_STATEMENT(keyword, table->source, keyword);
			UNPACK_SQL_STATEMENT(value, keyword->v, value);
			TMPL(tmpl_emit_source, table, value->v.string_literal, tableName, key->unique_id,	\
					(void *)0, keys_to_match, EmitSourceForm_Value);
		}
	}
	return;
}
%{}
