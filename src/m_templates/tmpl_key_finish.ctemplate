#include "octo_types.h"

#include "template_helpers.h"

/* Invoked when we are done processing a key FOR loop and need to clean up related lvns */
TEMPLATE(tmpl_key_finish, SqlKey *key) {
	%{}ZKILL {}%
	TMPL(tmpl_key, key);
	switch(key->fixed_to_value_type) {
	case LP_BOOLEAN_LESS_THAN:
	case LP_BOOLEAN_GREATER_THAN:
	case LP_BOOLEAN_LESS_THAN_OR_EQUALS:
	case LP_BOOLEAN_GREATER_THAN_OR_EQUALS:
	case LP_BOOLEAN_REGEX_SENSITIVE_LIKE_PREFIX_ONLY:
	case LP_BOOLEAN_REGEX_SENSITIVE_LIKE_PREFIX:
	case LP_BOOLEAN_REGEX_INSENSITIVE_LIKE_PREFIX:
		%{}  KILL {{ PP_YDB_OCTO_ZKEYFIX }}({{ key->unique_id|%d }}){}%
		break;
	default:
		if (key->is_order_by_xref_walk) {
			/* The cross reference walk of an ORDER BY (YDBOcto#1160) uses these (see "tmpl_tablejoin") */
			%{}  KILL {{ PP_YDB_OCTO_ZKEYFIX }}({{ key->unique_id|%d }}),{{ PP_YDB_OCTO_NULLFLAG }}({{ key->unique_id|%d }}){}%
		}
		break;
	}
	return;
}
%{}
