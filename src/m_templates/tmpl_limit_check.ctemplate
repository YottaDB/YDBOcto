#include "physical_plan.h"
#include "template_helpers.h"

/* Emit the M expression that compares the LIMIT of the query with a count of rows
 *
 * Emits "prefix" followed by "(limit" "suffix" ")", where "limit" is the LIMIT value of the query. "suffix" is a comparison
 * of that value with a variable, e.g. "'>" PP_YDB_OCTO_ZLIMIT. If "suffix_unique_id" is not 0, that variable gets it as a
 * subscript (the unique_id of the output key whose rows are counted), e.g. "(limit'>%ydboctozlimit(3))". Plan unique_ids
 * start at 1 (see "parse_line()"), so 0 means "no subscript".
 */
TEMPLATE(tmpl_limit_check, SqlOptionalKeyword *limit_keyword, char *prefix, char *suffix, int suffix_unique_id) {
	SqlValue	*limit;

	UNPACK_SQL_STATEMENT(limit, limit_keyword->v, value);
	%{}{{ prefix }}{}%
	if (limit->parameter_index) {
		/* Fetch the limit value stored at the parameter index */
		%{}($GET({{ config->global_names.cursor }}(cursorId,{{ PP_PARAMETERS }},{{ limit->parameter_index|%d }})){}%
	} else {
		/* This is a view's processing where limit value is stored in the `limit_keyword`
		 * itself to generate different M plans when the stored value is different.
		 * Use the stored value directly.
		 */
		%{}(({{ limit->v.string_literal }}){}%
	}
	%{}{{ suffix }}{}%
	if (0 != suffix_unique_id) {
		%{}({{ suffix_unique_id|%d }}){}%
	}
	%{}){}%
	return;
}
%{}
