#include "physical_plan.h"
#include "template_helpers.h"

#define OCTO_AIM_XREF_COMMENT "xref for table %s column %s"
// Adding one below for null terminator as LIT_LEN does not include it.
#define OCTO_AIM_XREF_COMMENT_MAXSIZE (LIT_LEN(OCTO_AIM_XREF_COMMENT) + 1 /* null */ - 4 /* strlen("%s")*2 */ +  OCTO_MAX_IDENT * 2)

/* Builds the AIM transformation "outer levels" spec for a piece-of-piece (chained DELIMS/PIECES) column
 * (YDBOcto#1108). The chained DELIMS/PIECES value lists have N (>= 2) elements; level 1 (the inner piece)
 * is passed to XREFDATA^%YDBAIM by the caller, which AIM extracts. This returns the remaining levels 2..N
 * as a "/"-separated list of "piece:<tag><c1.c2..>" where the delimiter is encoded by its decimal character
 * codes and <tag> is a single letter that tells the M-side decoder how to rebuild the delimiter:
 *      'Z' - the codes are BYTE values (a literal delimiter, emitted here byte-by-byte). The decoder uses
 *            $ZCHAR so a multi-byte UTF-8 delimiter is reproduced exactly (rebuilding those byte codes with
 *            $CHAR would treat each byte as a Unicode code point and yield a different string in UTF-8 mode).
 *      'C' - the codes are Unicode CODE POINTS (a "DELIMS ($C(..))" delimiter, whose code points are copied
 *            through verbatim). The decoder uses $CHAR, exactly as the read-side plan emits "$CHAR(..)"
 *            verbatim -- so both honor the runtime chset (M vs UTF-8) the same way.
 * The spec therefore contains only digits, the separators "/" ":" "." and the tag letters, which is safe to
 * embed as a literal in the generated M source. The matching M-side decoder is
 * "PieceOfPieceXform^%ydboctoplanhelpers". Allocated with octo_cmalloc (freed when query execution completes).
 */
static char *get_piece_of_piece_outer_spec(SqlValueList *delim_list, SqlValueList *piece_list) {
	SqlValueList *cur_delim, *cur_piece;
	SqlValue     *tmp_value;
	char	     *spec, *out;
	int	      alloc_size, remaining;
	boolean_t     first_level;

	/* Upper bound: per level, the piece number (INT32_TO_STRING_MAX) + ':' + the tag letter + up to 4 bytes
	 * per delimiter character ("255.") + a '/' separator, plus a null terminator. */
	alloc_size = 1;
	cur_delim = delim_list;
	do {
		UNPACK_SQL_STATEMENT(tmp_value, cur_delim->value, value);
		alloc_size += INT32_TO_STRING_MAX + 3 + ((int)strlen(tmp_value->v.string_literal) * 4) + 1;
		cur_delim = cur_delim->next;
	} while (cur_delim != delim_list);
	spec = octo_cmalloc(memory_chunks, alloc_size);
	out = spec;
	remaining = alloc_size;

	cur_delim = delim_list->next; /* skip level 1 (the inner piece, passed to XREFDATA separately) */
	cur_piece = piece_list->next;
	first_level = TRUE;
	while (cur_delim != delim_list) {
		SqlValue *delim_value, *piece_value;
		char	 *delim, flag, *piece;
		int	  copied;

		UNPACK_SQL_STATEMENT(delim_value, cur_delim->value, value);
		UNPACK_SQL_STATEMENT(piece_value, cur_piece->value, value);
		delim = delim_value->v.string_literal;
		flag = delim[0];
		delim++; /* skip the flag byte to get the delimiter text */
		piece = piece_value->v.string_literal;

		/* Emit "<sep>piece:<tag>": tag 'C' for a $CHAR delimiter (code points, decode with $CHAR), 'Z' for a
		 * literal delimiter (byte codes, decode with $ZCHAR -- byte-exact for multi-byte UTF-8; YDBOcto#1108). */
		copied = snprintf(out, remaining, "%s%s:%c", (first_level ? "" : "/"), piece,
				  ((DELIM_IS_DOLLAR_CHAR == flag) ? 'C' : 'Z'));
		assert(copied < remaining);
		out += copied;
		remaining -= copied;
		first_level = FALSE;

		if (DELIM_IS_DOLLAR_CHAR == flag) {
			/* "$CHAR(c1,c2,..)": copy the codes verbatim, turning the commas into dots. */
			char *delim_ptr;

			delim_ptr = delim + (sizeof("$CHAR(") - 1);
			while (('\0' != *delim_ptr) && (')' != *delim_ptr)) {
				assert(remaining > 1);
				*out++ = ((',' == *delim_ptr) ? '.' : *delim_ptr);
				delim_ptr++;
				remaining--;
			}
		} else {
			/* literal delimiter: emit each byte's decimal character code, dot-separated. */
			char	 *delim_ptr;
			boolean_t first_code;

			first_code = TRUE;
			for (delim_ptr = delim; '\0' != *delim_ptr; delim_ptr++) {
				copied = snprintf(out, remaining, "%s%d", (first_code ? "" : "."),
						  (unsigned char)*delim_ptr);
				assert(copied < remaining);
				out += copied;
				remaining -= copied;
				first_code = FALSE;
			}
		}
		cur_delim = cur_delim->next;
		cur_piece = cur_piece->next;
	}
	*out = '\0';
	return spec;
}

TEMPLATE(tmpl_physical_plan, PhysicalPlan *pplan) {
	unsigned int		cur_key;
	int			dot_count;
	SqlOptionalKeyword	*limit_keyword;

	// Entrypoint xrefPlan(cursorId) at the top of the routine
	// NB: We don't use cursorId anymore for xrefs in globals, but lvn
	// tables (such as pg_settings) use it
	%{}`n{{ pplan->plan_name }}(cursorId)`n{{ PLAN_LINE_START }}{}%

	/* Handle LP_INSERT_INTO/LP_DELETE_FROM/LP_UPDATE plans first as they are relatively easy to handle */
	if (IS_INSERT_INTO_PHYSICAL_PLAN(pplan)) {
		TMPL(tmpl_insert_into, pplan);
		return;
	}

	// The below initialization is needed for cross-reference plans and the regular plans
	assert(NULL == pplan->treat_key_as_null);
	pplan->treat_key_as_null = octo_cmalloc(memory_chunks, sizeof(boolean_t) * config->plan_id);

	if (IS_DELETE_FROM_PHYSICAL_PLAN(pplan)) {
		TMPL(tmpl_delete_from, pplan);
		return;
	}
	if (IS_UPDATE_PHYSICAL_PLAN(pplan)) {
		TMPL(tmpl_update_table, pplan);
		return;
	}
	assert(NULL != pplan->outputKey);
	// Check if there are any cross references that need to be built
	if (pplan->outputKey->is_cross_reference_key) {
		SqlTable		*table;
		SqlColumn		*column;
		boolean_t		is_dollar_char;
		SqlOptionalKeyword	*keyword;
		SqlValue		*value;
		char			*tableName;
		char			*columnName;
		char			*source;
		char			*delim;
		char			*piece;
		char			comment[OCTO_AIM_XREF_COMMENT_MAXSIZE];
		boolean_t		is_multi_level_piece; /* YDBOcto#1108: TRUE for a piece-of-piece column */
		char			*outer_spec;	      /* the piece-of-piece transform's outer-levels spec */

		// Get table, column, table name, column name
		table = pplan->outputKey->table;
		column = pplan->outputKey->column;
		UNPACK_SQL_STATEMENT(value, pplan->outputKey->table->tableName, value);
		tableName = value->v.reference;
		UNPACK_SQL_STATEMENT (value, pplan->outputKey->column->columnName, value);
		columnName = value->v.reference;

		// Get Piece
		keyword = get_keyword(column, OPTIONAL_PIECE);
		is_multi_level_piece = FALSE;
		outer_spec = NULL;
		if (NULL != keyword) {
			if (value_list_STATEMENT == keyword->v->type) {
				/* YDBOcto#1108: Piece-of-piece column. AIM is given the INNER (first) piece below
				 * (delim/piece), so it watches/extracts the right node; the remaining (outer) levels
				 * are applied as an AIM transformation function (see the type==2 path below). Here we
				 * grab the inner piece # and build the outer-levels spec for that transform.
				 */
				SqlValueList *piece_list, *delim_list;

				is_multi_level_piece = TRUE;
				UNPACK_SQL_STATEMENT(piece_list, keyword->v, value_list);
				UNPACK_SQL_STATEMENT(value, piece_list->value, value); /* inner (first) piece */
				piece = value->v.string_literal;
				assert(NULL != column->delim);
				UNPACK_SQL_STATEMENT(delim_list, column->delim, value_list);
				outer_spec = get_piece_of_piece_outer_spec(delim_list, piece_list);
			} else {
				UNPACK_SQL_STATEMENT(value, keyword->v, value);
				piece = value->v.string_literal;
			}
		} else {
			piece = NULL;
		}

		/* Get SUBSTR specification (YDBOcto#763/#764). A SUBSTR column is indexed through an AIM
		 * transformation function ("SubstrXform", or a trailing argument to "PieceOfPieceXform" for a
		 * DELIMS/PIECES + SUBSTR column) so that AIM indexes the $EXTRACT'ed value the read-side plans
		 * look up. For the whole-node form the column carries an implicit DELIM "" and no PIECE keyword,
		 * so the delimiter/piece arguments below come out empty, which is exactly AIM's whole-node form.
		 */
		SqlOptionalKeyword	*substr_keyword;
		char			*substr_spec;

		substr_keyword = get_keyword(column, OPTIONAL_SUBSTR);
		if (NULL != substr_keyword) {
			UNPACK_SQL_STATEMENT(value, substr_keyword->v, value);
			substr_spec = value->v.string_literal;
		} else {
			substr_spec = NULL;
		}

		// Get Delimiter
		if (column->delim) {
			if (value_list_STATEMENT == column->delim->type) {
				/* Piece-of-piece column: use the INNER (first) delimiter for the AIM piece. */
				SqlValueList *delim_list;

				UNPACK_SQL_STATEMENT(delim_list, column->delim, value_list);
				UNPACK_SQL_STATEMENT(value, delim_list->value, value);
			} else {
				UNPACK_SQL_STATEMENT(value, column->delim, value);
			}
			delim = value->v.string_literal;
			is_dollar_char = (DELIM_IS_DOLLAR_CHAR == delim[0] ? TRUE : FALSE);
			delim = &value->v.string_literal[1];
		} else if (table->delim) {
			UNPACK_SQL_STATEMENT(keyword, table->delim, keyword);
			UNPACK_SQL_STATEMENT(value, keyword->v, value);
			delim = value->v.string_literal;
			is_dollar_char = (DELIM_IS_DOLLAR_CHAR == delim[0] ? TRUE : FALSE);
			delim = &value->v.string_literal[1];
		} else {
			delim = COLUMN_DELIMITER;
			is_dollar_char = FALSE;
		}

		// Get source
		keyword = get_keyword(column, OPTIONAL_EXTRACT);
		if (NULL == keyword) {
			keyword = get_keyword(column, OPTIONAL_GLOBAL);
			if (NULL == keyword) {
				UNPACK_SQL_STATEMENT(keyword, table->source, keyword);
			}
		}
		UNPACK_SQL_STATEMENT(value, keyword->v, value);
		source = value->v.string_literal;

		/* Does this cross reference need a decoupled record anchor? See the block comment below. */
		boolean_t needs_anchor;
		needs_anchor = !table_columns_all_on_row_node(table);

		/* YDBAIM#96: the AIM "type" is no longer chosen by the user. The table-level AIMTYPE keyword is
		 * still parsed and still round-trips through emit_create_table(), but nothing reads it here any
		 * more; it is accepted purely so existing DDL keeps loading.
		 *
		 * What it used to select was whether a row whose value node is ABSENT gets indexed as SQL NULL.
		 * That is not a preference: a row exists because the TABLE's global reference says so, not
		 * because any one column happens to have a node, so "absent means NULL" is simply what SQL
		 * means. AIMTYPE 0 - the default, and so the overwhelming majority of tables - therefore gave
		 * wrong answers to "WHERE col IS NULL" whenever a row was missing that column's node, and
		 * AIMTYPE 1 was the manual opt-out from being wrong.
		 *
		 * So a cross reference is built as type 4 (6 when composed with a transformation function):
		 * a DECOUPLED RECORD ANCHOR on the table's own global reference, alongside the column's
		 * value spec. Row existence then comes from the same place a full table scan gets it, which
		 * is what makes the cross reference and the scan agree.
		 *
		 * The exception is a table whose columns ALL take their value from the row node itself -
		 * no column carries a GLOBAL of its own, so each is a piece of that one node. There the
		 * schema declares exactly one node per row, and "tmpl_tablejoin" scans such a table by
		 * requiring that node to hold a value. Type 0 (2 with a transformation function) indexes
		 * precisely the nodes that hold a value, so it already agrees with that scan, and the
		 * anchor would only add record-side triggers that fire on every write. A missing PIECE of
		 * a node that exists is still indexed as NULL by type 0, so nothing is lost.
		 */

		// Create comment
		snprintf(comment, OCTO_AIM_XREF_COMMENT_MAXSIZE, OCTO_AIM_XREF_COMMENT, tableName, columnName);

		// Write M code for %YDBAIM
		// If Global (most Octo tables are except rare ones like pg_settings)
		if ('^' == pplan->outputKey->xref_prefix[0]) {
			%{}NEW base,subs DO baseSubs(.base,.subs){}%
			%{}`n{{ PLAN_LINE_START }}{}%
			if (needs_anchor) {
				%{}NEW recbase,recsub DO recSubs(.recbase,.recsub){}%
				%{}`n{{ PLAN_LINE_START }}{}%
			}
			%{}; XREFDATA parameters: global, subscripts, delimiter, piece, nmonly (0 here),{}%
			%{} zpiece (always 0), omitfix (always 1),{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{};   stat (0 for now), AIM Metadata Type (always decoupled - 4, or 6 when a{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{};   transformation function is used - so that a row whose value node is absent{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{};   is still indexed, under NULL; the record anchor comes from recSubs),{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{};   forceStrOrder (1 for STRING type columns so canonical strings are correctly ordered, 0 otherwise){}%

			%{}`n{{ PLAN_LINE_START }}{}%
			%{}NEW aimglobal SET aimglobal=$$XREFDATA^%%YDBAIM(base,.subs,{}%
			if (is_dollar_char) {
				%{}{{delim}}{}%
			} else {
				%{}"{{delim}}"{}%
			}
			if (NULL == piece) {
				%{},{}%
			} else {
				%{},{{piece}}{}%
			}

			// Add arguments needed by AIM: nmonly (0=build), zpiece, omitfix, stat
			%{},0,0,1,0,{}%
			/* Add the AIM metadata type, the transformation-function argument (if any) and the
			 * record anchor arguments (if needed), then close the XREFDATA call.
			 */
			TMPL(tmpl_xref_type_transform, table, column, needs_anchor, is_multi_level_piece, outer_spec, substr_spec);
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}; Now that xref building is complete, cleanup saved cancel related state information{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}KILL {{OCTOLIT_YDBOCTOCANCEL}}("{{tableName}}","{{columnName}}","{{OCTOLIT_AIM_SUB_CANCELXREF}}"){}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}; Put the comment in again, in case it's deleted after the metadata is created {}%
			%{}but before the xref is built{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}NEW comment SET comment="{{ comment }}"{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			if (NULL == piece) {
				%{}SET @aimglobal@("comment-0")=comment{}%
			} else {
				%{}SET @aimglobal@("comment-{{piece}}")=comment{}%
			}
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}; And mark that we are done with building xref so we won't try to build again{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}SET {{OCTOLIT_AIM_OCTO_CACHE}}("{{tableName}}","{{columnName}}","{{OCTOLIT_AIM_SUB_COMPLETED}}")=1{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}; This is redundant, but is here just in case the {{OCTOLIT_AIM_OCTO_CACHE}} global is deleted.{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}; Otherwise, %%ydboctoDiscard will have no way to figure out how to discard the AIM global.{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			if (NULL == piece) {
				%{}SET {{OCTOLIT_AIM_OCTO_CACHE}}("{{tableName}}","{{columnName}}","{{OCTOLIT_AIM_SUB_LOCATION}}"{}%
				%{})=$name(@aimglobal@(0)){}%
			} else {
				%{}SET {{OCTOLIT_AIM_OCTO_CACHE}}("{{tableName}}","{{columnName}}","{{OCTOLIT_AIM_SUB_LOCATION}}"{}%
				%{})=$name(@aimglobal@({{piece}})){}%
			}
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}QUIT{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{};{}%
			%{}`n{}%

			// Entry point xrefMetadata
			%{}`nxrefMetadata ; called by src/physical/emit_physical_plan.c after xref plan generation{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}NEW base,subs DO baseSubs(.base,.subs){}%
			%{}`n{{ PLAN_LINE_START }}{}%
			if (needs_anchor) {
				%{}NEW recbase,recsub DO recSubs(.recbase,.recsub){}%
				%{}`n{{ PLAN_LINE_START }}{}%
			}
			%{}; XREFDATA parameters: global, subscripts, delimiter, piece, nmonly (1 here), zpiece (always 0),{}%
			%{} omitfix (always 1),{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{};   stat (0 for now), AIM Metadata Type (always decoupled - 4, or 6 when a{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{};   transformation function is used - so that a row whose value node is absent{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{};   is still indexed, under NULL; the record anchor comes from recSubs),{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}NEW aimglobal SET aimglobal=$$XREFDATA^%%YDBAIM(base,.subs{}%
			if (is_dollar_char) {
				%{},{{delim}}{}%
			} else {
				%{},"{{delim}}"{}%
			}
			if (NULL == piece) {
			%{},""{}%
			} else {
			%{},{{piece}}{}%
			}
			// Add arguments needed by AIM: nmonly (1=metadata), zpiece, omitfix, stat
			%{},1,0,1,0,{}%
			// Same type + transform as the nmonly=0 build call above (one template keeps them in sync; the
			// AIM global name returned by this nmonly=1 call, and cached for the read-side plan, hashes them).
			TMPL(tmpl_xref_type_transform, table, column, needs_anchor, is_multi_level_piece, outer_spec, substr_spec);
			%{}`n{{ PLAN_LINE_START }}{}%
			if (NULL == piece) {
				%{}SET {{OCTOLIT_AIM_OCTO_CACHE}}("{{tableName}}","{{columnName}}","{{OCTOLIT_AIM_SUB_LOCATION}}"{}%
				%{})=$name(@aimglobal@(0)){}%
			} else {
				%{}SET {{OCTOLIT_AIM_OCTO_CACHE}}("{{tableName}}","{{columnName}}","{{OCTOLIT_AIM_SUB_LOCATION}}"{}%
				%{})=$name(@aimglobal@({{piece}})){}%
			}
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}SET {{OCTOLIT_AIM_OCTO_CACHE}}("{{tableName}}","{{columnName}}","{{OCTOLIT_AIM_SUB_COMPLETED}}")=0{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}; Cancelation information for _ydboctoCleanup.m{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}SET {{OCTOLIT_YDBOCTOCANCEL}}("{{tableName}}","{{columnName}}","{{OCTOLIT_AIM_SUB_CANCELXREF}}")=""{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}NEW comment SET comment="{{ comment }}"{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			if (NULL == piece) {
				%{}SET @aimglobal@("comment-0")=comment{}%
			} else {
				%{}SET @aimglobal@("comment-{{piece}}")=comment{}%
			}
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}QUIT{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{};{}%
			%{}`n{}%

			// Private entry point baseSubs
			%{}`nbaseSubs:(base,subs) ; Private entry point for use by other labels in this routine{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}NEW global SET global=$NAME({}%
			TMPL(tmpl_emit_source, table, source, tableName, pplan->outputKey->unique_id, (void *)0, MAX_KEY_COUNT,	\
				EmitSourceForm_AIM);
			%{}){}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}NEW subn for subn=1:1:$QLENGTH(global) DO{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}. SET subs(subn)=$QSUBSCRIPT(global,subn){}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}. IF subs(subn)'[":" SET subs(subn)=$ZWRITE(subs(subn)){}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}SET base=$QSUBSCRIPT(global,0){}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}NEW eref set eref=$QSUBSCRIPT(global,-1){}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}IF eref'="" SET base="^|"""_eref_"""|"_$ZPIECE(base,"^",2){}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}QUIT{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{};{}%
			%{}`n{}%
			// Private entry point recSubs (YDBAIM#96): the DECOUPLED RECORD ANCHOR.
			//
			// baseSubs above says where the COLUMN VALUE lives. recSubs says where a ROW lives,
			// which for Octo is always the table's own global reference - the thing a full table
			// scan walks. Handing AIM both lets it index a NULL for a column whose node is absent
			// while the row still exists, no matter where that column sits relative to the row.
			//
			// Emitted only when the cross reference asks for an anchor. A table whose columns all
			// live on the row node declares exactly one node per row, is scanned by requiring that
			// node to hold a value, and is cross referenced as type 0 - which indexes exactly the
			// nodes holding a value - so it needs no anchor and no record-side triggers at all.
			//
			// The anchor's DEPTH is the row's own subscript count plus K, K being how far the
			// deepest column reaches BELOW the row inside the row's own global. AIM watches every
			// level down to that depth, because a row can be created or destroyed by a write at
			// any of them and a trigger only ever fires on the node actually written. K is a
			// property of the table, so every column's cross reference on a table gets the same
			// anchor.
			//
			// The depth goes in the ROOT of recsub (YottaDB/Util/YDBAIM#96). The levels below the
			// row are simply left unnamed - AIM takes an unnamed level to vary and name nothing.
			// They used to be spelled as trailing recsub(n)="*" entries, which produced the very
			// same subscript match as ":" and differed only in not counting as a key column; the
			// depth says it once, and unambiguously.
			//
			// K is computed in M rather than in C for the same reason baseSubs computes the
			// subscript count in M: $QLENGTH of a $NAME is exact, whereas counting subscripts in C
			// means parsing keys(...), nested parentheses and quoted literals out of a string.
			if (needs_anchor) {
				SqlColumn	   *start_column, *cur_column;
				SqlOptionalKeyword *col_keyword;
				char		   *row_source;
				char		  **seen_source;
				int		    num_seen, num_columns, prior;

				UNPACK_SQL_STATEMENT(keyword, table->source, keyword);
				UNPACK_SQL_STATEMENT(value, keyword->v, value);
				row_source = value->v.string_literal;

				%{}`nrecSubs:(recbase,recsub) ; Private entry point for use by other labels in this routine{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; The RECORD ANCHOR: where a ROW lives, as against where this column's VALUE lives{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; (baseSubs above). Giving AIM both is what lets a row whose value node is absent{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; be indexed as SQL NULL rather than left out of the cross reference altogether.{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; The anchor's depth is the row's subscript count plus K, K being how far the{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; table's deepest column reaches below the row within the row's own global. AIM{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; watches every level down to it, because a row can come into or go out of{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; existence by a write at any of them and a trigger fires only for the node{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; actually written.{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}NEW rowref SET rowref=$NAME({}%
				TMPL(tmpl_emit_source, table, row_source, tableName, pplan->outputKey->unique_id,	\
					(void *)0, MAX_KEY_COUNT, EmitSourceForm_AIM);
				%{}){}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}NEW rowdepth SET rowdepth=$QLENGTH(rowref){}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}NEW subn FOR subn=1:1:rowdepth DO{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}. SET recsub(subn)=$QSUBSCRIPT(rowref,subn){}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}. IF recsub(subn)'[":" SET recsub(subn)=$ZWRITE(recsub(subn)){}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}SET recbase=$QSUBSCRIPT(rowref,0){}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}NEW receref SET receref=$QSUBSCRIPT(rowref,-1){}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}IF receref'="" SET recbase="^|"""_receref_"""|"_$ZPIECE(recbase,"^",2){}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}NEW colref,k SET k=0{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; one measurement per DISTINCT column global; K is their maximum{}%

				/* Emit one recSpan call per DISTINCT column global reference.
				 *
				 * recSpan only folds a column's depth into a running maximum, so measuring the
				 * same global reference twice cannot change K. Columns sharing a node are the
				 * norm rather than the exception - a VistA table routinely maps dozens of
				 * columns to pieces of one node - and this block is regenerated in the xref
				 * plan of every indexed column of the table, so emitting the duplicates once
				 * cost hundreds of identical lines per plan.
				 *
				 * Two kinds of column are skipped outright:
				 *   - one with no GLOBAL of its own, or one naming the table's own global
				 *     reference: its value node IS the row, so it reaches zero levels below
				 *     the row and recSpan would quit on its first depth test;
				 *   - an EXTRACT column, which has no global reference to measure.
				 *
				 * De-duplication is by source text. Two spellings of the same node would
				 * survive as separate entries, which costs a redundant line and nothing else.
				 */
				UNPACK_SQL_STATEMENT(start_column, table->columns, column);
				num_columns = 0;
				cur_column = start_column;
				do {
					num_columns++;
					cur_column = cur_column->next;
				} while (cur_column != start_column);

				seen_source = (char **)octo_cmalloc(memory_chunks, sizeof(char *) * num_columns);
				num_seen = 0;

				cur_column = start_column;
				do {
					col_keyword = get_keyword(cur_column, OPTIONAL_EXTRACT);
					if (NULL == col_keyword) {
						col_keyword = get_keyword(cur_column, OPTIONAL_GLOBAL);
						if (NULL != col_keyword) {
							char *col_source;

							UNPACK_SQL_STATEMENT(value, col_keyword->v, value);
							col_source = value->v.string_literal;

							for (prior = 0; prior < num_seen; prior++) {
								if (0 == strcmp(col_source, seen_source[prior])) {
									break;
								}
							}
							if ((prior == num_seen) && (0 != strcmp(col_source, row_source))) {
								seen_source[num_seen++] = col_source;
								%{}`n{{ PLAN_LINE_START }}{}%
								%{}SET colref=$NAME({}%
								TMPL(tmpl_emit_source, table, col_source,	\
									tableName, pplan->outputKey->unique_id,	\
									(void *)0, MAX_KEY_COUNT, EmitSourceForm_AIM);
								%{}) DO recSpan{}%
							}
						}
					}
					cur_column = cur_column->next;
				} while (cur_column != start_column);
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}SET recsub=rowdepth+k ; the anchor's DEPTH: AIM watches every level down to it{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}QUIT{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{};{}%
				%{}`nrecSpan ; fold one column's depth below the row into k{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; a column in another global or another database is a value anchor: writing it{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}; cannot bring a row into existence, so it says nothing about how deep a row runs{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}QUIT:$QSUBSCRIPT(colref,0)'=$QSUBSCRIPT(rowref,0){}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}QUIT:$QSUBSCRIPT(colref,-1)'=$QSUBSCRIPT(rowref,-1){}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}QUIT:$QLENGTH(colref)'>rowdepth{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}SET:$QLENGTH(colref)-rowdepth>k k=$QLENGTH(colref)-rowdepth{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}QUIT{}%
				%{}`n{{ PLAN_LINE_START }}{}%
				%{};{}%
				%{}`n{}%
			}
		} else { // This is table kept in a local variable, e.g. pg_settings
			/* If this is a plan for a cross reference, put safeguards in place (i.e. QUIT) to prevent building twice.
			 * The completion marker is the "xref_status" node this plan SETs below, once the cross reference is built.
			 */
			%{}IF $DATA({{ pplan->outputKey->xref_prefix }}{{ config->global_names.raw_octo }}({{ PP_XREF_STATUS }},{}%
			%{}"{{ tableName }}","{{ columnName }}")) {}%
			%{}QUIT`n{{ PLAN_LINE_START }}{}%
			%{}; Store state information in case query is canceled in middle of xref building`n{{ PLAN_LINE_START }}{}%
			%{}; Actual cleanup happens in _ydboctoCleanup.m using this saved state information{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}SET {{OCTOLIT_YDBOCTOCANCEL}}("{{ tableName }}","{{ columnName }}","{{OCTOLIT_YDBOCTOCANCELLOCALXF}}"{}%
			%{})="{{ pplan->outputKey->xref_prefix }}{{ config->global_names.raw_xref }}(""{}%
			%{}{{ tableName }}"",""{{ columnName }}"")" ; Note: NULL value of {{ columnName }} is stored as ""{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}; Populate cross reference`n{{ PLAN_LINE_START }}{}%
			%{}DO populateXref`n{{ PLAN_LINE_START }}{}%
			%{}SET {{ pplan->outputKey->xref_prefix }}{{ config->global_names.raw_octo }}({{ PP_XREF_STATUS }},{}%
			%{}"{{ tableName }}","{{ columnName }}")=""{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}; Now that xref building is complete, cleanup saved cancel related state information{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}KILL {{OCTOLIT_YDBOCTOCANCEL}}`n{{ PLAN_LINE_START }}{}%
			%{}QUIT`n{}%
			// Generate the populateXref entryref here
			%{}`npopulateXref`n{{ PLAN_LINE_START }}{}%
			%{}; Build cross reference for {{ columnName }} column in {{ tableName }} table`n{{ PLAN_LINE_START }}{}%
			%{}KILL {{ pplan->outputKey->xref_prefix }}{{ config->global_names.raw_xref }}{}%
			%{}("{{ tableName }}","{{ columnName }}"){}%
			%{}  ; Remove prior cross reference data (if any still exists)`n{{ PLAN_LINE_START }}{}%
			cur_key = 0;
			dot_count = 0;
			TMPL(tmpl_tablejoin, pplan, pplan->tablejoin, cur_key, FALSE, dot_count, tableName, columnName);
			%{}`n{{ PLAN_LINE_START }}QUIT{}%
		}
		return;
	}

	/* Not a cross-reference plan. This must be a LP_TABLE_VALUE or LP_SELECT_QUERY plan. Handle both cases separately. */
	/* New variables that are used in almost every plan. This is needed since deferred plans can be called from
	 * within another plan (see "XECUTE" in "GetScalarOrArray" entryref in "src/aux/_ydboctoplanhelpers.m")
	 * and we do not want say "%ydboctoexpr" variable in the deferred plan to affect the variable of the same
	 * name (but holding a completely different value) in the caller plan.
	 */
	%{}NEW {{ PP_YDB_OCTO_Z }},{{ PP_YDB_OCTO_EXPR }}{}%
	if (IS_GROUP_BY_PLAN(pplan)) {
		/* If this physical plan uses GROUP BY/HAVING/AGGREGATE FUNCTIONS, make sure to NEW PP_YDB_OCTO_G
		 * to avoid altering a variable of the same name in a caller physical plan corresponding to an
		 * outer query (#814)
		 */
		%{},{{ PP_YDB_OCTO_G }}{}%
	}

	boolean_t	is_insert_into_values;	/* used for optimization in case of INSERT INTO .. VALUES (YDBOcto#910) */
	is_insert_into_values = FALSE;
	if (LP_TABLE_VALUE == pplan->lp_select_query->type) {
		LogicalPlan	*lp_table_data, *lp_row_value;
		PhysicalPlan	*parent_pplan;

		parent_pplan = pplan->parent_plan;
		if ((NULL != parent_pplan) && IS_INSERT_INTO_PHYSICAL_PLAN(parent_pplan)) {
			LogicalPlan	*lp_insert_into, *lp_select_query;

			lp_insert_into = parent_pplan->lp_select_query;
			GET_LP_INSERT_INTO_SELECT_QUERY(lp_insert_into, lp_select_query);
			is_insert_into_values = (LP_TABLE_VALUE == lp_select_query->type);
		}

		assert(NULL == pplan->dnf_prev);
		assert(NULL == pplan->dnf_next);
		assert(NULL == pplan->order_by);
		assert(!pplan->emit_duplication_check);
		assert(!pplan->distinct_values);
		assert(!pplan->distinct_values);
		%{} KILL {}%
		TMPL(tmpl_key, pplan->outputKey);
		%{}`n{{ PLAN_LINE_START }}{}%
		GET_LP(lp_table_data, pplan->lp_select_query, 0, LP_TABLE_DATA);
		GET_LP(lp_row_value, lp_table_data, 1, LP_ROW_VALUE);
		dot_count = 1;
		do {
			LogicalPlan	*lp_column_list;
			boolean_t	stash_columns_in_keys;

			assert(LP_ROW_VALUE == lp_row_value->type);
			%{}IF $INCREMENT({}%
			TMPL(tmpl_key, pplan->outputKey);
			%{}) DO{}%
			%{}`n{{ PLAN_LINE_START }}{}%
			GET_LP(lp_column_list, lp_row_value, 0, LP_COLUMN_LIST);
			stash_columns_in_keys = pplan->stash_columns_in_keys;
			TMPL(tmpl_column_list_combine, lp_column_list, pplan, "_", !stash_columns_in_keys, dot_count, FALSE, TRUE);
			if (!stash_columns_in_keys) {
				if (!is_insert_into_values) {
					%{}SET {}%
					TMPL(tmpl_key, pplan->outputKey); (*buffer_index)--;
					%{},{}%
					TMPL(tmpl_key, pplan->outputKey);
					%{}){}%
					%{}={{ PP_YDB_OCTO_EXPR }}{}%
					if (NULL != lp_row_value->v.lp_default.operand[1]) {
						%{}`n{{ PLAN_LINE_START }}{}%
					}
				}
			} else {
				%{}IF $INCREMENT({}%
				TMPL(tmpl_key, pplan->outputKey); (*buffer_index)--;
				%{},{}%
				%{}{{ PP_YDB_OCTO_EXPR }}{}%
				%{})){}%
				if (NULL != lp_row_value->v.lp_default.operand[1]) {
					%{}`n{{ PLAN_LINE_START }}{}%
				}
			}
			GET_LP_ALLOW_NULL(lp_row_value, lp_row_value, 1, LP_ROW_VALUE);
		} while (NULL != lp_row_value);
	} else {
		assert(LP_SELECT_QUERY == pplan->lp_select_query->type);
		limit_keyword = get_keyword_from_keywords(pplan->keywords, OPTIONAL_LIMIT);
		if ((NULL != limit_keyword) && (NULL == pplan->dnf_prev)) {
			%{} SET {{ PP_YDB_OCTO_ZLIMIT }}({{ pplan->outputKey->unique_id|%d }})=0{}%
		}
		if (NULL == pplan->dnf_prev) {
			%{} KILL {}%
			TMPL(tmpl_key, pplan->outputKey);
			/* By the same reasoning as in "tmpl_update_table.ctemplate", we do the KILL of
			 * PP_YDB_OCTO_ZDUPLICATE at the start of this function instead of at the end of this function.
			 * In this case, an example runtime error from a prior select is ERR_SUBQUERY_MULTIPLE_ROWS.
			 */
			if (pplan->emit_duplication_check) {
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}KILL {{ PP_YDB_OCTO_ZDUPLICATE }}({{ pplan->outputKey->unique_id|%d }}){}%
			}
		}
		%{}`n{{ PLAN_LINE_START }}{}% // Whitespace for MUMPS
		cur_key = 0;
		dot_count = 0;
		assert(FALSE == pplan->tablejoin_body_group_by_done);
		TMPL(tmpl_tablejoin, pplan, pplan->tablejoin, cur_key, FALSE, dot_count, NULL, NULL);
		/* If this plan has GROUP BY or HAVING or Aggregate function usage, "tmpl_tablejoin" would not have generated
		 * output keys in the usual format. It would have generated GROUP BY related subscript lvn tree that needs
		 * to be converted into an output key. Do that here.
		 */
		if (IS_GROUP_BY_PLAN(pplan) && (NULL == pplan->dnf_next)) {
			assert(FALSE == pplan->tablejoin_body_group_by_done);
			pplan->tablejoin_body_group_by_done = TRUE;
			TMPL(tmpl_group_by, pplan, dot_count);
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}KILL {}%
			TMPL(tmpl_key, pplan->outputKey); (*buffer_index)--;
			%{},{{ PP_GROUP_BY }}){}%
		}
		// If this expression had an order by, we now need to go back and make the ordering uniform
		// If we have a lot of plans each of which have the same output key and order by, then do this step
		// only for the last plan in that set.
		if ((NULL != pplan->order_by) && (NULL == pplan->dnf_next)) {
			LogicalPlan		*order_by;
			int			num_cols;

			order_by = pplan->order_by;
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}NEW {{ PP_YDB_OCTO_I }}  SET {{ PP_YDB_OCTO_I }}(0)=1`n{{ PLAN_LINE_START }}{}%
			assert(NULL != pplan->outputKey);
			// Determine how many columns are specified in ORDER BY. Need to generate M code accordingly.
			// The below code is a simplified version of that in "tmpl_column_list_combine.ctemplate".
			num_cols = 0;
			do {
				boolean_t	is_desc;

				assert(LP_ORDER_BY == order_by->type);
				is_desc = (OPTIONAL_DESC == order_by->extra_detail.lp_order_by.direction);
				/* Check if column is a table.*.
				 * This check is based on how tmpl_column_list_combine.ctemplate writes the `table.*` of ORDER BY.
				 * So, any change there will need a change here.
				 */
				boolean_t is_table_asterisk_and_in_group_by = FALSE;
				SqlColumnAlias  *tbl_asterisk_column_alias;
				// check column table_asterisk
				if (pplan->tablejoin_body_group_by_done) {
					LogicalPlan     *tmpPlan;
					GET_LP(tmpPlan, order_by, 0, LP_COLUMN_LIST);
					GET_LP(tmpPlan, tmpPlan, 0, LP_WHERE);
					tmpPlan = tmpPlan->v.lp_default.operand[0];
					if (IS_LP_COLUMN_ALIAS_OR_LP_DERIVED_COLUMN(tmpPlan)) {
						GET_COLUMN_ALIAS_FROM_LP_COLUMN_ALIAS_OR_LP_DERIVED_COLUMN(tmpPlan,
													tbl_asterisk_column_alias);
						if (is_stmt_table_asterisk(tbl_asterisk_column_alias->column)
						    && (0 < tbl_asterisk_column_alias->group_by_column_number)) {
							is_table_asterisk_and_in_group_by = TRUE;
						}
					}
				}
				if (is_table_asterisk_and_in_group_by) {
					// Get table column list
					SqlStatement *cur_table_alias_stmt = tbl_asterisk_column_alias->table_alias_stmt;
					assert(NULL != cur_table_alias_stmt);
					SqlTableAlias *cur_table_alias;
					UNPACK_SQL_STATEMENT(cur_table_alias, cur_table_alias_stmt, table_alias);

					/* Need to order a Composite NULL last (even after ROW(NULL)) (see the following thread for
					 * more details: https://gitlab.com/YottaDB/DBMS/YDBOcto/-/issues/759#note_736104049).
					 * Achieve this ordering by using "$ZYSQLNULL" in case of a Composite NULL and "0"
					 * otherwise. We expect in this case to have the first node to be either 0 or "$ZYSQLNULL".
					 * So include that first before continuing with other columns.
					 */
					TMPL(tmpl_print_dots, num_cols);
					num_cols++;
					%{}SET {{ PP_YDB_OCTO_I }}({{ num_cols|%d }})="" {}%
					TMPL(tmpl_order_by_sort, pplan, is_desc, num_cols, limit_keyword);

					/* Traverse the column list to sort table.* ORDER BY value as we added each
					 * column of table.* individually by seperating the GROUP BY table.* value
					 */
					SqlColumnListAlias *start_cla, *cur_cla;
					UNPACK_SQL_STATEMENT(start_cla, cur_table_alias->column_list, column_list_alias);
					cur_cla = start_cla;
					do {
						TMPL(tmpl_print_dots, num_cols);
						num_cols++;
						%{}SET {{ PP_YDB_OCTO_I }}({{ num_cols|%d }})="" {}%
						TMPL(tmpl_order_by_sort, pplan, is_desc, num_cols, limit_keyword);
						cur_cla = cur_cla->next;
					} while (cur_cla != start_cla);
				} else {
					TMPL(tmpl_print_dots, num_cols);
					num_cols++;
					%{}SET {{ PP_YDB_OCTO_I }}({{ num_cols|%d }})="" {}%
					TMPL(tmpl_order_by_sort, pplan, is_desc, num_cols, limit_keyword);
				}
				GET_LP_ALLOW_NULL(order_by, order_by, 1, LP_ORDER_BY);
			} while (NULL != order_by);
			TMPL(tmpl_print_dots, num_cols);
			num_cols++;
			%{}SET {{ PP_YDB_OCTO_I }}({{ num_cols|%d }})="" {}%
			%{}FOR  SET {{ PP_YDB_OCTO_I }}({{ num_cols|%d }})=$ORDER({}%
			TMPL(tmpl_key, pplan->outputKey); (*buffer_index)--;
			TMPL(tmpl_order_by_key, num_cols);
			%{})) QUIT:({{ PP_YDB_OCTO_I }}({{ num_cols|%d }})=""){}%
			if (NULL != limit_keyword) {
				TMPL(tmpl_limit_check, limit_keyword, "!", "<%ydboctoi(0)");
			}
			%{}  DO`n{{ PLAN_LINE_START }}{}%
			TMPL(tmpl_print_dots, num_cols);
			if (!pplan->stash_columns_in_keys) {
				%{}SET {}%
				TMPL(tmpl_key, pplan->outputKey); (*buffer_index)--;
				%{},{{ PP_YDB_OCTO_I }}(0))={}%
				TMPL(tmpl_key, pplan->outputKey); (*buffer_index)--;
				TMPL(tmpl_order_by_key, num_cols);
			} else {
				/* Plan is part of a sub-query with an ORDER BY. Finish actual stashing of keys in columns
				 * that was deferred in "tmpl_populate_output_key".
				 */
				%{}IF $INCREMENT({}%
				TMPL(tmpl_key, pplan->outputKey); (*buffer_index)--;
				%{},{}%
				TMPL(tmpl_key, pplan->outputKey); (*buffer_index)--;
				TMPL(tmpl_order_by_key, num_cols);
				%{})){}%
			}
			%{})`n{{ PLAN_LINE_START }}{}%
			TMPL(tmpl_print_dots, num_cols);
			%{}IF $INCREMENT({{ PP_YDB_OCTO_I }}(0)){}%
			%{}`n{{ PLAN_LINE_START }}{}%
			%{}KILL {}%
			TMPL(tmpl_key, pplan->outputKey); (*buffer_index)--;
			%{},{{ PP_ORDER_BY }}){}%
			%{}`n{{ PLAN_LINE_START }}SET {}%
			TMPL(tmpl_key, pplan->outputKey); (*buffer_index)--;
			%{})={{ PP_YDB_OCTO_I }}(0)-1{}%
		}
		if (NULL == pplan->dnf_next) {
			if (NULL != limit_keyword) {
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}KILL {{ PP_YDB_OCTO_ZLIMIT }}({{ pplan->outputKey->unique_id|%d }}){}%
			}
			if (pplan->distinct_values) {
				%{}`n{{ PLAN_LINE_START }}{}%
				%{}KILL {{ PP_YDB_OCTO_ZDISTINCT }}({{ pplan->outputKey->unique_id|%d }}){}%
			}
		}
	}
	if (!is_insert_into_values) {
		%{}`n{{ PLAN_LINE_START }}{}%
	}
	%{}QUIT{}%
	return;
}
%{}
