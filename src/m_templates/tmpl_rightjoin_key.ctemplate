#include "physical_plan.h"
#include "template_helpers.h"

TEMPLATE(tmpl_rightjoin_key, PhysicalPlan *pplan, unsigned int key_start, unsigned int key_end) {
	boolean_t	is_first_key;

	%{}{{ key_start|%d }}{}%
	assert(key_start < key_end);
	is_first_key = TRUE;
	do {
		SqlKey	*key;

		key = pplan->iterKeys[key_start];
		/* The primary keys of the row. The cross reference key of a primary key column (YDBOcto#660) is one:
		 * two rows that differ only in that column are two rows.
		 */
		if (IS_ROW_KEY(key)) {
			%{},{}%
			TMPL(tmpl_key, key);
			is_first_key = FALSE;
		}
		key_start++;
	} while (key_start < key_end);
	assert(!is_first_key);
	UNUSED(is_first_key);	/* Only consumed by the assert above; quiets release-build warnings */
	return;
}
%{}
