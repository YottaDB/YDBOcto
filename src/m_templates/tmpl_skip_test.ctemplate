#include "octo_types.h"
#include "logical_plan.h"

#include "template_helpers.h"

/* Emit the M expression that tests if a value is in the SKIP list of a key column
 *
 * Emits the test of a column-level SKIP keyword: "$SELECT(<lvn>=v1:1,<lvn>=v2:1,...,1:0)", which is 1 when <lvn> holds one of
 * the values of the SKIP list.
 *
 * "skip_keyword" is the SKIP keyword of a key column. Its argument is a comma-separated list of M values. It is split on the
 * commas that are not inside an M double-quoted string, and each value is emitted as is.
 * "key" says which lvn holds the value to test: the key's own lvn ("tmpl_key") when it is not NULL, and
 * PP_YDB_OCTO_EXPR ("%ydboctoexpr") when it is NULL.
 */
TEMPLATE(tmpl_skip_test, SqlOptionalKeyword *skip_keyword, SqlKey *key) {
	SqlValue	*value;
	char		*list, *piece_start, *p;
	boolean_t	in_quotes;

	UNPACK_SQL_STATEMENT(value, skip_keyword->v, value);
	list = value->v.string_literal;

	%{}$SELECT({}%
	in_quotes = FALSE;
	piece_start = list;
	p = list;
	while (TRUE) {
		char		ch;
		boolean_t	at_separator;

		ch = *p;
		at_separator = (('\0' == ch) || ((',' == ch) && !in_quotes));
		if (at_separator) {
			/* Skip empty pieces (e.g. trailing comma); should not occur after the parser-level non-empty check,
			 * but be defensive.
			 */
			if (piece_start < p) {
				char *q;

				if (NULL != key) {
					TMPL(tmpl_key, key);
				} else {
					%{}{{ PP_YDB_OCTO_EXPR }}{}%
				}
				%{}={}%
				for (q = piece_start; q < p; q++) {
					%{}{{ *q|%c }}{}%	/* Emit the piece verbatim */
				}
				%{}:1,{}%
			}
			if ('\0' == ch) {
				break;
			}
			piece_start = p + 1;
		} else if ('"' == ch) {
			in_quotes = !in_quotes;
		}
		p++;
	}
	%{}1:0){}%
	return;
}
%{}
