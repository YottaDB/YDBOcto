#include "physical_plan.h"
#include "template_helpers.h"

/* Emit the M code that answers MIN/MAX from one value, without visiting the rows (YDBOcto#617)
 *
 * Emits the M code of the YDBOcto#617 optimization: each MIN or MAX of the query reads the first or last value of its
 * source, without visiting the rows of the table ("is_octo617_optimization_possible()" decides when this is possible).
 *
 * Each aggregate function of the query gets its own lines. They end with one SET that stores the value in the
 * GROUP BY node of the output key, if there is a value:
 *     SET:<a value was found> <output key>,"GroupBy","",<aggregate number>)=<value>
 *
 * Where the value comes from decides which template emits the lines before that SET, and its postconditional:
 *   - a literal, e.g. MAX(5): "tmpl_octo617_key_global", which finds whether the table has a row;
 *   - the AIM cross reference of the column: "tmpl_octo617_xref";
 *   - the table's global, for the key column of a table with one key column: "tmpl_octo617_key_global".
 * This template then emits the target of the SET.
 */
TEMPLATE(tmpl_tablejoin_octo617_optimize, PhysicalPlan *pplan, int dot_count) {
	LogicalPlan	*af, *first_aggregate;

	assert(pplan->is_octo617_optimized);
	first_aggregate = pplan->lp_select_query->extra_detail.lp_select_query.first_aggregate;
	for (af = first_aggregate; NULL != af; af = af->extra_detail.lp_aggregate_function.next_aggregate) {
		LogicalPlan	*lp_column_list, *lp_argument;
		boolean_t	is_value_in_expr1;	/* The value is in %ydboctoexpr(1), not in %ydboctoexpr */

		assert((LP_AGGREGATE_FUNCTION_MIN == af->type) || (LP_AGGREGATE_FUNCTION_MAX == af->type));
		if (af != first_aggregate) {
			%{}`n{{ PLAN_LINE_START }}{}%
		}
		GET_LP(lp_column_list, af, 0, LP_COLUMN_LIST);
		lp_argument = lp_column_list->v.lp_default.operand[0];
		TMPL(tmpl_print_dots, dot_count);

		if (LP_VALUE == lp_argument->type) {
			/* MIN or MAX of a literal is the literal if the table has a row, and NULL otherwise. The table has a
			 * row if its first key column has a first value, which is what MIN of that key column looks for. The
			 * key column's value is not used: the literal is kept in %ydboctoexpr(1).
			 */
			%{}SET {{ PP_YDB_OCTO_EXPR }}(1)={}%
			TMPL(tmpl_print_expression, lp_argument, pplan, dot_count, 0);
			%{}`n{{ PLAN_LINE_START }}{}%
			TMPL(tmpl_print_dots, dot_count);
			TMPL(tmpl_octo617_key_global, pplan, LP_AGGREGATE_FUNCTION_MIN, FALSE, dot_count);
			is_value_in_expr1 = TRUE;
		} else {
			SqlColumn	*aggr_column;

			assert(LP_COLUMN_ALIAS == lp_argument->type);
			assert(column_STATEMENT == lp_argument->v.lp_column_alias.column_alias->column->type);
			aggr_column = lp_argument->v.lp_column_alias.column_alias->column->v.column;
			if (NULL != af->extra_detail.lp_aggregate_function.octo617_xref_plan) {
				/* A non-key column, any column of a table with several key columns, a string key column, or a
				 * key column whose cross reference holds converted values (YDBOcto#660)
				 */
				TMPL(tmpl_octo617_xref, pplan, aggr_column, af->type, dot_count);
				/* A string value is decoded from its cross reference subscript into %ydboctoexpr(1) */
				is_value_in_expr1 = IS_COLUMN_STRING_TYPE(aggr_column);
			} else {
				/* The key column of a table with one key column, whose values are the subscripts of the
				 * table's global
				 */
				assert(aggr_column == pplan->iterKeys[0]->column);
				TMPL(tmpl_octo617_key_global, pplan, af->type, TRUE, dot_count);
				is_value_in_expr1 = FALSE;
			}
		}

		/* The target of the SET whose postconditional was emitted above */
		int	aggregate_cnt;

		aggregate_cnt = af->extra_detail.lp_aggregate_function.aggregate_cnt;
		%{} {}%
		TMPL(tmpl_key, pplan->outputKey);
		(*buffer_index)--;
		%{},{{ PP_GROUP_BY }},"",{{ aggregate_cnt|%d }})={{ PP_YDB_OCTO_EXPR }}{}%
		if (is_value_in_expr1) {
			%{}(1){}%
		}
	}
	return;
}
%{}
