# Only the "puts" lines below go to stdout (and so to the reference file). The terminal session goes to expect.dbg.
log_user 0
set timeout 60

spawnbash

# Note "expect_after" needs to be done AFTER spawn or else it won't take effect
expect_after {
	timeout { timeout_procedure }
}

proc timeout_procedure { } {
	puts "timeout occurred"
	exit -1
}

# Expects PATTERN (exact match) from octo, with no other output before it. Prints PASS if so and WRONG otherwise.
proc check {what pattern} {
	expect {
		-exact $pattern {
			if {$pattern eq $expect_out(buffer)} {
				puts "PASS : $what"
			} else {
				puts "WRONG : $what : unexpected output: $expect_out(buffer)"
			}
		}
		timeout { puts "WRONG : $what : did not see the expected output within $::timeout seconds" }
		eof { puts "WRONG : $what : octo terminated" }
	}
}

expect -re "\[#\$] "
# Enable long lines to prevent wrapping
send -- "stty cols 4096\r"
expect -re "\[#\$] "

# The "octo_dbg_ctrlc_after_query_m_code" env var makes a Debug build of octo send itself a SIGINT (as a Ctrl-C does)
# right after the M code of each query is done and before its rows are printed. The terminal does not echo "^C" for it.
puts "# Start octo with a test hook that sends a Ctrl-C right after the M code of a query is done"
send -- "octo_dbg_ctrlc_after_query_m_code=1 octo\r"
expect "OCTO> "

puts "# Run \[select * from names;\]"
send -- "select * from names;\r"
expect "names;\r\n"
check "Ctrl-C after the M code is done cancels the SELECT before any row is printed" "\r\n\[ERROR\]: ERR_QUERY_CANCELED: canceling statement due to user request\r\nOCTO> "

puts "# Exit octo"
send -- "exit\r"
expect -re "\[#\$] "
send -- "exit\r"
expect eof
