load test_helpers

setup() {
  init_test
}

teardown() {
  corecheck
}

@test "HDB01 : Can communicate and load data into Postgres" {
	# Postgres function to delete all tables in a database for a clean test run
	cat >drop_all_tables.cmd <<-SQL_CODE
		DO \$\$
		DECLARE
			r RECORD;
		BEGIN
			FOR r IN (SELECT tablename FROM pg_tables WHERE schemaname = 'public') LOOP
				EXECUTE 'DROP TABLE IF EXISTS ' || quote_ident(r.tablename) || ' CASCADE';
			END LOOP;
			FOR r IN (SELECT viewname FROM pg_views WHERE schemaname = 'public') LOOP
				EXECUTE 'DROP VIEW IF EXISTS ' || quote_ident(r.viewname) || ' CASCADE';
			END LOOP;
		END \$\$;
	SQL_CODE

	echo "\d" > listdb.sql

	for schema in $schema_list
	do
		# Clean databases created by prior test runs that terminated early
		# as vestigal data causes unexpected test output, leading to test failures.
		# In Postgres a user cannot delete a table made by another user in a previous test run
		# so instead of deleting the database, delete all tables in the database -- if the database exists
		# Test if the database exists
		if [[ $(psql -v ON_ERROR_STOP=1 -tAc "SELECT 1 FROM pg_database WHERE datname='$schema'") ]]; then
			# Delete all tables in the database
			psql -v ON_ERROR_STOP=1 $schema -f drop_all_tables.cmd >& postgres.drop_database_$schema.out
		fi
		create_postgres_database "$schema" &> "$schema".postgres.create || true
		# Wrap sql file with BEGIN/COMMIT to speed up the commit by 4 seconds
		# This is not done in the actual file because the files are sometimes loaded later into Octo, which fails on BEGIN/COMMIT
		{ echo "BEGIN;"; cat @PROJECT_SOURCE_DIR@/tests/fixtures/postgres-"$schema".sql; echo "COMMIT;"; } |
			psql "$schema" -v ON_ERROR_STOP=1 &> $1.psql.load || true
		# This is needed for the QueryGenarator program. Load it once for each database.
		# (QueryGenerator is used to generate random queries to compare Octo to Postgres)
		load_postgres_fixture "$schema" postgres-QueryGenerator.sql

		# Do minimal check of database contents after postgres load
		# First find list of table names in this database/schema
		psql --no-align "$schema" -f listdb.sql | grep public | awk -F'|' '{print $2;}' >& tables_"$schema".txt
		declare -a tablearray
		readarray -t tablearray < tables_"$schema".txt
		i=0
		while (( ${#tablearray[@]} > i )); do
			tablename=${tablearray[i++]}
			inputfile="input_${schema}_${tablename}.sql"
			outputfile="output_${schema}_${tablename}.txt"
			echo 'select * from "'$tablename'";'  > "$inputfile"
			psql --no-align "$schema" -f "$inputfile" >& "$outputfile"
			echo "#######################################################################" >> output.txt
			echo "# Listing first 3 lines and last 3 lines of [SCHEMA : "$schema"] [TABLE : "$tablename"]" >> output.txt
			echo "#######################################################################" >> output.txt
			head -1 "$outputfile" | tr '[:upper:]' '[:lower:]' >> output.txt 2>&1
			sed -n '2,4p' "$outputfile" | sort >> output.txt 2>&1
			echo "..." >> output.txt
			echo "..." >> output.txt
			if [[ $tablename == "shippers" ]]; then
				tail -4 "$outputfile" | grep -v rows | sort >> output.txt 2>&1
			else
				tail -5 "$outputfile" | grep -v rows | sort >> output.txt 2>&1
			fi
		done
	done
	# Format output to ensure a common output format
	sed -i 's/|t|/|1|/g;' output.txt
	sed -i 's/|f|/|0|/g;' output.txt
	sed -i 's/|t$/|1/g;' output.txt
	sed -i 's/|f$/|0/g;' output.txt
	mv output.txt output-postgres.txt
	verify_output HDB01-postgres output-postgres.txt nodatetimefilter # HDB01-postgres.ref
}
