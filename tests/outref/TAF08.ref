# verify_aim_rebuild : 10 index entries maintained by the triggers, against a rebuild from scratch
# PASS : identical

#######################################################
# XREFDATA calls generated for these tables
#######################################################
NEW aimglobal SET aimglobal=$$XREFDATA^%YDBAIM(base,.subs,"^",1,0,0,1,0,4,1,,recbase,.recsub)
NEW aimglobal SET aimglobal=$$XREFDATA^%YDBAIM(base,.subs,"^",1,1,0,1,0,4,1,,recbase,.recsub)
NEW aimglobal SET aimglobal=$$XREFDATA^%YDBAIM(base,.subs,"^",2,0,0,1,0,4,1,,recbase,.recsub)
NEW aimglobal SET aimglobal=$$XREFDATA^%YDBAIM(base,.subs,"^",2,1,0,1,0,4,1,,recbase,.recsub)

OCTO> -- One query on its own, so that exactly one M plan is generated and can be shown. What the plan
-- must make visible is that MIN/MAX here really do read the cross reference's value dimension --
-- a $ORDER on the AIM global rather than a FOR loop over the table's keys -- because that is the
-- whole subject of this test. Anything the plan does about START is visible here too.
SELECT MIN(lo), MAX(hi) FROM hdr;
min|max
apple|mango
(1 row)
OCTO> 

#######################################################
# Generated M plan for MIN/MAX over the cross reference (the YDBOcto#617 optimization): hdr
#######################################################
    FOR  SET %ydboctoexpr=$ORDER(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(2,%ydboctoexpr),-1) QUIT:(%ydboctoexpr="")  DO  QUIT:%ydboctocursor(cursorId,"keys",1,"hdr","ien")'=""
    . SET %ydboctocursor(cursorId,"keys",1,"hdr","ien")=$ORDER(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(2,%ydboctoexpr,0))
    SET:$DATA(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(2,%ydboctoexpr)) %ydboctocursor(cursorId,"keys",3,"","","GroupBy","",2)=%ydboctoexpr(1)
    FOR  SET %ydboctoexpr=$ORDER(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(1,%ydboctoexpr),1) QUIT:(%ydboctoexpr="")  DO  QUIT:%ydboctocursor(cursorId,"keys",1,"hdr","ien")'=""
    . SET %ydboctocursor(cursorId,"keys",1,"hdr","ien")=$ORDER(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(1,%ydboctoexpr,0))
    SET:$DATA(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(1,%ydboctoexpr)) %ydboctocursor(cursorId,"keys",3,"","","GroupBy","",1)=%ydboctoexpr(1)
    SET:'$DATA(%ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog,2)) %ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog,2)=$ZYSQLNULL
    SET:'$DATA(%ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog,1)) %ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog,1)=$ZYSQLNULL
    FOR  DO:$DATA(%ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog))  SET %ydboctog=$ORDER(%ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog)) QUIT:(""=%ydboctog)
    . . SET:1&$INCREMENT(%ydboctocursor(cursorId,"keys",3,"","")) %ydboctoz=42

OCTO> -- The same single query as TAF08c.sql, but against the STARTINCLUDE table, so the two plans can be
-- compared directly. Same global, same cross reference, same aggregates - the only difference in
-- the DDL is STARTINCLUDE, so any difference in the plan is what that keyword costs.
SELECT MIN(lo), MAX(hi) FROM hdrinc;
min|max
apple|mango
(1 row)
OCTO> 

#######################################################
# Generated M plan for MIN/MAX over the cross reference (the YDBOcto#617 optimization): hdrinc, the STARTINCLUDE table
#######################################################
    SET %ydboctoexpr=$ORDER(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(2,""),-1)
    SET:$DATA(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(2,%ydboctoexpr))&(""=$$aimsubs2strcolval^%ydboctoplanhelpers(%ydboctoexpr)) %ydboctoexpr=$ORDER(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(2,%ydboctoexpr),-1)
    SET:$DATA(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(2,%ydboctoexpr)) %ydboctocursor(cursorId,"keys",3,"","","GroupBy","",2)=%ydboctoexpr(1)
    SET %ydboctoexpr=$ORDER(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(1,""),1)
    SET:$DATA(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(1,%ydboctoexpr))&(""=$$aimsubs2strcolval^%ydboctoplanhelpers(%ydboctoexpr)) %ydboctoexpr=$ORDER(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(1,%ydboctoexpr),1)
    SET:$DATA(^%ydbAIMDYjWyHYr57KWYNlt0zceNDE(1,%ydboctoexpr)) %ydboctocursor(cursorId,"keys",3,"","","GroupBy","",1)=%ydboctoexpr(1)
    SET:'$DATA(%ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog,2)) %ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog,2)=$ZYSQLNULL
    SET:'$DATA(%ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog,1)) %ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog,1)=$ZYSQLNULL
    FOR  DO:$DATA(%ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog))  SET %ydboctog=$ORDER(%ydboctocursor(cursorId,"keys",3,"","","GroupBy",%ydboctog)) QUIT:(""=%ydboctog)
    . . SET:1&$INCREMENT(%ydboctocursor(cursorId,"keys",3,"","")) %ydboctoz=42

#######################################################
# AIM index
#######################################################
^%ydbAIMD5jqamlCd85H2emOBJa2bK8="^ORDST"
^%ydbAIMD5jqamlCd85H2emOBJa2bK8(0)="*YottaDB*"
^%ydbAIMD5jqamlCd85H2emOBJa2bK8(1)=2
^%ydbAIMD5jqamlCd85H2emOBJa2bK8(1,"#",0)=""
^%ydbAIMD5jqamlCd85H2emOBJa2bK8(1,"#complete",2)=""
^%ydbAIMD5jqamlCd85H2emOBJa2bK8(1,"#discontinued",1)=""
^%ydbAIMD5jqamlCd85H2emOBJa2bK8(1,"#pending",3)=""
^%ydbAIMD5jqamlCd85H2emOBJa2bK8(2)="^"
^%ydbAIMD5jqamlCd85H2emOBJa2bK8(3)="#1"
