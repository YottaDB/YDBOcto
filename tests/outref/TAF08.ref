
#######################################################
# PART 1 of 2 : ^ORDST, the VistA shape
#######################################################
OCTO> -- TAF08 PART 1 of 2 : the VistA shape, on ^ORDST. Part 2 (TAF08d.sql) is a separate global and a
-- separate set of tables; the two are kept apart so each can be read on its own.

-- MIN/MAX (the YDBOcto#617 optimization) over a type=4 cross reference whose key range starts at
-- a node that is not a row.

-- Every other read path walks the TABLE's global and uses the cross reference only to advance
-- keys, so it sees the key range the way the table declares it. The YDBOcto#617 optimization does
-- not: for MIN(col)/MAX(col) it $ORDERs the cross reference's VALUE dimension directly and returns
-- the first subscript it lands on. It is the one read path that never applies START.

-- That matters because AIM's key range is INCLUSIVE at both ends while Octo's scan is not: the
-- scan seeds its key with the START value and $ORDERs past it. So the START node itself is in the
-- index and is not a row. Earlier AIM types hid this. They walked down to the VALUE node, so a
-- START node with nothing at the indexed depth was rejected by $DATA for free. type=4 has no such
-- test - the record anchor says any node in range is a row - which is exactly what lets it index a
-- row whose value node is absent as SQL NULL.

-- The data. ^ORDST(0) is the FileMan file header: it holds a value, but it has no `0` node
-- beneath it, so it has nothing at the depth `name` is indexed at. It enters the index in the NULL
-- bucket, which AIM writes as the bare "#" and which sorts BEFORE every real value. Ascending MIN
-- therefore lands on it first and has to step past it. SQL aggregates ignore NULL inputs, so that
-- step is required anyway and the header is dropped as a side effect.
SELECT XECUTE_M_CODE('zwrite ^ORDST');
^ORDST(0)="ORDER STATUS^100.01^3"
^ORDST(1,0)="discontinued"
^ORDST(1,"VUID")=4500704
^ORDST(2,0)="complete"
^ORDST(3,0)="pending"
xecute_m_code
0
(1 row)
OCTO> -- ordstat : ien START 0 (exclusive), no ENDPOINT, so the rows are ien 1,2,3 and NOT ien 0.
--   name is piece 1 of ^ORDST(ien,0) -> {discontinued,complete,pending}, MIN complete, MAX pending
CREATE TABLE ordstat (
 ien INTEGER PRIMARY KEY START 0,
 name VARCHAR(30) GLOBAL "^ORDST(keys(""ien""),0)" PIECE 1,
 vuid VARCHAR(30) GLOBAL "^ORDST(keys(""ien""),""VUID"")" PIECE 1
) GLOBAL "^ORDST(keys(""ien""))" DELIM "^";
CREATE TABLE
OCTO> -- The row universe as a full table scan sees it: ien 0 is excluded by START, so 1, 2 and 3.
SELECT * FROM ordstat ORDER BY ien;
ien|name|vuid
1|discontinued|4500704
2|complete|
3|pending|
(3 rows)
OCTO> -- MIN/MAX on a non-key column: the YDBOcto#617 optimization, reading the value dimension directly.
SELECT MIN(name), MAX(name) FROM ordstat;
min|max
complete|pending
(1 row)
OCTO> -- The same two answers computed WITHOUT that optimization - a WHERE clause disables it, so these
-- go through the ordinary key walk, which does apply START. The two must agree.
SELECT MIN(name) FROM ordstat WHERE name IS NOT NULL;
min
complete
(1 row)
OCTO> SELECT MAX(name) FROM ordstat WHERE name IS NOT NULL;
max
pending
(1 row)
OCTO> -- MIN/MAX on the KEY column. This does not use a cross reference at all - it seeds from START and
-- $ORDERs past it - so it is the contrast case: 1 and 3, not 0 and 3.
SELECT MIN(ien), MAX(ien) FROM ordstat;
min|max
1|3
(1 row)
OCTO> -- Which rows are in the NULL bucket, asked through the key walk. ien 0 is in that bucket in the
-- index and is not a row, so this must not report it.
SELECT * FROM ordstat WHERE name IS NULL ORDER BY ien;
ien|name|vuid
(0 rows)
OCTO> -- Aggregates that are never optimized, for the row counts: 3 rows, 3 non-NULL names, 1 non-NULL vuid.
SELECT COUNT(*), COUNT(name), COUNT(vuid) FROM ordstat;
count(*)|count|count
3|3|1
(1 row)
OCTO> 

#######################################################
# STEP: set ^ORDST(0,0)="aardvark"
# Give the FileMan HEADER a node at the indexed depth. It stops being a NULL and becomes a real value below every row, and MIN(name) must still ignore it.
#######################################################
OCTO> -- The ^ORDST questions from TAF08.sql that can disagree, re-asked after a change to ^ORDST.
SELECT XECUTE_M_CODE('zwrite ^ORDST');
^ORDST(0)="ORDER STATUS^100.01^3"
^ORDST(0,0)="aardvark"
^ORDST(1,0)="discontinued"
^ORDST(1,"VUID")=4500704
^ORDST(2,0)="complete"
^ORDST(3,0)="pending"
xecute_m_code
0
(1 row)
OCTO> SELECT * FROM ordstat ORDER BY ien;
ien|name|vuid
1|discontinued|4500704
2|complete|
3|pending|
(3 rows)
OCTO> SELECT MIN(name), MAX(name) FROM ordstat;
min|max
complete|pending
(1 row)
OCTO> SELECT MIN(name) FROM ordstat WHERE name IS NOT NULL;
min
complete
(1 row)
OCTO> SELECT MAX(name) FROM ordstat WHERE name IS NOT NULL;
max
pending
(1 row)
OCTO> 

#######################################################
# STEP: zkill ^ORDST(0,0)
# And back to a missing-node NULL, which is the bucket SQL aggregates have to ignore anyway.
#######################################################
OCTO> -- The ^ORDST questions from TAF08.sql that can disagree, re-asked after a change to ^ORDST.
SELECT XECUTE_M_CODE('zwrite ^ORDST');
^ORDST(0)="ORDER STATUS^100.01^3"
^ORDST(1,0)="discontinued"
^ORDST(1,"VUID")=4500704
^ORDST(2,0)="complete"
^ORDST(3,0)="pending"
xecute_m_code
0
(1 row)
OCTO> SELECT * FROM ordstat ORDER BY ien;
ien|name|vuid
1|discontinued|4500704
2|complete|
3|pending|
(3 rows)
OCTO> SELECT MIN(name), MAX(name) FROM ordstat;
min|max
complete|pending
(1 row)
OCTO> SELECT MIN(name) FROM ordstat WHERE name IS NOT NULL;
min
complete
(1 row)
OCTO> SELECT MAX(name) FROM ordstat WHERE name IS NOT NULL;
max
pending
(1 row)
OCTO> 

#######################################################
# PART 2 of 2 : ^HDR, where the node at START has a value at the indexed depth
#######################################################
OCTO> -- TAF08 PART 2 of 2 : the same defect on ^HDR, where the node at START has a real value at the
-- indexed depth. Part 1 (TAF08.sql) covered ^ORDST and is independent of this.

-- Unlike ^ORDST(0), ^HDR(0,0) is not a missing-node NULL, so nothing about NULL handling applies
-- to it: it enters the value dimension as an ordinary subscript. `lo` piece 1 of the START node
-- sorts BELOW every row's value and `hi` piece 2 sorts ABOVE every row's, so if the value
-- dimension is read without applying START, it is MIN(lo) and MAX(hi) that pick it up.
SELECT XECUTE_M_CODE('zwrite ^HDR');
^HDR(0,0)="aaaa^zzzz"
^HDR(1,0)="mango^mango"
^HDR(2,0)="apple^apple"
xecute_m_code
0
(1 row)
OCTO> -- hdr : ien START 0 (exclusive), no ENDPOINT, so the rows are ien 1,2 and NOT ien 0.
--   lo is piece 1 of ^HDR(ien,0) -> {mango,apple}, MIN apple, MAX mango
--   hi is piece 2 of ^HDR(ien,0) -> {mango,apple}, MIN apple, MAX mango
--   The values `aaaa` and `zzzz` sitting at ien 0 must appear in NO answer below.
CREATE TABLE hdr (
 ien INTEGER PRIMARY KEY START 0,
 lo VARCHAR(30) GLOBAL "^HDR(keys(""ien""),0)" PIECE 1,
 hi VARCHAR(30) GLOBAL "^HDR(keys(""ien""),0)" PIECE 2
) GLOBAL "^HDR(keys(""ien""))" DELIM "^";
CREATE TABLE
OCTO> -- The row universe: ien 1 and 2. ien 0 is excluded by START even though ^HDR(0,0) exists.
SELECT * FROM hdr ORDER BY ien;
ien|lo|hi
1|mango|mango
2|apple|apple
(2 rows)
OCTO> -- The optimized MIN/MAX, reading the value dimension directly.
SELECT MIN(lo), MAX(lo) FROM hdr;
min|max
apple|mango
(1 row)
OCTO> SELECT MIN(hi), MAX(hi) FROM hdr;
min|max
apple|mango
(1 row)
OCTO> -- The same answers with the optimization disabled by a WHERE clause. Any disagreement with the two
-- queries above is the START node leaking out of the index into an aggregate.
SELECT MIN(lo) FROM hdr WHERE lo IS NOT NULL;
min
apple
(1 row)
OCTO> SELECT MAX(lo) FROM hdr WHERE lo IS NOT NULL;
max
mango
(1 row)
OCTO> SELECT MIN(hi) FROM hdr WHERE hi IS NOT NULL;
min
apple
(1 row)
OCTO> SELECT MAX(hi) FROM hdr WHERE hi IS NOT NULL;
max
mango
(1 row)
OCTO> -- And the key column, which does apply START: 1 and 2.
SELECT MIN(ien), MAX(ien) FROM hdr;
min|max
1|2
(1 row)
OCTO> -- hdrinc : the SAME global and the SAME range, but declared STARTINCLUDE, which makes the START
-- value part of the range. So ien 0 IS a row here and nothing may be skipped.
--   rows are ien 0,1,2
--   lo -> {aaaa,mango,apple}, MIN aaaa, MAX mango
--   hi -> {zzzz,mango,apple}, MIN apple, MAX zzzz
--   Every one of those differs from `hdr` above wherever ien 0 is the extreme. The cross reference
--   is identical - AIM is handed the same `0:` either way - so the only thing separating these
--   answers from `hdr`'s is how Octo reads the index.
CREATE TABLE hdrinc (
 ien INTEGER PRIMARY KEY START 0 STARTINCLUDE,
 lo VARCHAR(30) GLOBAL "^HDR(keys(""ien""),0)" PIECE 1,
 hi VARCHAR(30) GLOBAL "^HDR(keys(""ien""),0)" PIECE 2
) GLOBAL "^HDR(keys(""ien""))" DELIM "^";
CREATE TABLE
OCTO> -- The row universe now includes ien 0.
SELECT * FROM hdrinc ORDER BY ien;
ien|lo|hi
0|aaaa|zzzz
1|mango|mango
2|apple|apple
(3 rows)
OCTO> -- The optimized MIN/MAX, which must NOT step past ien 0.
SELECT MIN(lo), MAX(lo) FROM hdrinc;
min|max
aaaa|mango
(1 row)
OCTO> SELECT MIN(hi), MAX(hi) FROM hdrinc;
min|max
apple|zzzz
(1 row)
OCTO> -- The same answers with the optimization disabled by a WHERE clause, as above.
SELECT MIN(lo) FROM hdrinc WHERE lo IS NOT NULL;
min
aaaa
(1 row)
OCTO> SELECT MAX(hi) FROM hdrinc WHERE hi IS NOT NULL;
max
zzzz
(1 row)
OCTO> -- And the key column: 0 and 2, where `hdr` gave 1 and 2.
SELECT MIN(ien), MAX(ien) FROM hdrinc;
min|max
0|2
(1 row)
OCTO> 

#######################################################
# STEP: zkill ^HDR(0,0)
# Take the START node value away. Whatever MIN/MAX change here was coming from a node that is not a row.
#######################################################
OCTO> -- The ^HDR questions from TAF08d.sql that can disagree, re-asked after a change to ^HDR.
SELECT XECUTE_M_CODE('zwrite ^HDR');
^HDR(1,0)="mango^mango"
^HDR(2,0)="apple^apple"
xecute_m_code
0
(1 row)
OCTO> -- hdr : ien 0 is NOT a row.
SELECT * FROM hdr ORDER BY ien;
ien|lo|hi
1|mango|mango
2|apple|apple
(2 rows)
OCTO> SELECT MIN(lo), MAX(lo) FROM hdr;
min|max
apple|mango
(1 row)
OCTO> SELECT MIN(hi), MAX(hi) FROM hdr;
min|max
apple|mango
(1 row)
OCTO> SELECT MIN(lo) FROM hdr WHERE lo IS NOT NULL;
min
apple
(1 row)
OCTO> SELECT MAX(hi) FROM hdr WHERE hi IS NOT NULL;
max
mango
(1 row)
OCTO> -- hdrinc : same global, but ien 0 IS a row.
SELECT * FROM hdrinc ORDER BY ien;
ien|lo|hi
1|mango|mango
2|apple|apple
(2 rows)
OCTO> SELECT MIN(lo), MAX(lo) FROM hdrinc;
min|max
apple|mango
(1 row)
OCTO> SELECT MIN(hi), MAX(hi) FROM hdrinc;
min|max
apple|mango
(1 row)
OCTO> SELECT MIN(lo) FROM hdrinc WHERE lo IS NOT NULL;
min
apple
(1 row)
OCTO> SELECT MAX(hi) FROM hdrinc WHERE hi IS NOT NULL;
max
mango
(1 row)
OCTO> 

