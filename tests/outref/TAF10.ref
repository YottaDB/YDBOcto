^TAF10x(1)=10
^TAF10x(2)=99
^TAF10x(3)=30
^TAF10x(4)=99
^TAF10x(5)=50
^TAF10x(6)=99
xecute_m_code
0
(1 row)

CREATE TABLE TAF10x (id INTEGER PRIMARY KEY ITERATOR "$$odd^TAF10", v INTEGER PIECE 1) GLOBAL "^TAF10x(keys(""id""))";
CREATE TABLE

