^TBO02d(1,2)=102
^TBO02d(1,3)=103
^TBO02d(1,4)=104
^TBO02d(1,5)=105
^TBO02d(1,6)=106
^TBO02d(1,7)=107
^TBO02d(1,8)=108
^TBO02d(1,9)=109
^TBO02d(1,10)=110
xecute_m_code
0
(1 row)

