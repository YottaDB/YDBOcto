# Generated nested $PIECE calls (piece-of-piece codegen -- Sections A/B):
$PIECE($PIECE($GET(^addrm(%ydboctocursor(cursorId,"keys",1,"addr_charmulti","id"))),$CHAR(124,124),2),"~~",1)
$PIECE($PIECE($GET(^addrm(%ydboctocursor(cursorId,"keys",1,"addr_multichar","id"))),"||",2),"~~",1)
$PIECE($PIECE($GET(^addrm(%ydboctocursor(cursorId,"keys",1,"addr_multichar","id"))),"||",2),"~~",3)
$PIECE($PIECE($GET(^addr(%ydboctocursor(cursorId,"keys",1,"addr_char","id"))),$CHAR(124),2),"^",1)
$PIECE($PIECE($GET(^addr(%ydboctocursor(cursorId,"keys",1,"addr","id"))),"|",2),"^",1)
$PIECE($PIECE($GET(^addr(%ydboctocursor(cursorId,"keys",1,"addr","id"))),"|",2),"^",2)
$PIECE($PIECE($GET(^addr(%ydboctocursor(cursorId,"keys",1,"addr","id"))),"|",2),"^",3)
$PIECE($PIECE($GET(^addr(%ydboctocursor(cursorId,"keys",1,"addr","id"))),"|",2),"^",4)
