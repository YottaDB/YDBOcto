# Stored text table definitions (round-trip; a single-element list downgrades to DELIM/PIECE):
^%ydboctoschema("addr","text",0)="CREATE TABLE `addr` (`id` INTEGER CONSTRAINT ""addr_pkey"" PRIMARY KEY, `name` VARCHAR(40) PIECE 1, `street` VARCHAR(40) DELIMS (""|"",""^"") PIECES (2,1), `apt` VARCHAR(40) DELIMS (""|"",""^"") PIECES (2,2), `city` VARCHAR(40) DELIMS (""|"",""^"") PIECES (2,3), `state` VARCHAR(40) DELIMS (""|"",""^"") PIECES (2,4), `phone` VARCHAR(40) PIECE 3) GLOBAL ""^addr(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("addr_char","text",0)="CREATE TABLE `addr_char` (`id` INTEGER CONSTRAINT ""addr_char_pkey"" PRIMARY KEY, `street` VARCHAR(40) DELIMS ($CHAR(124),""^"") PIECES (2,1)) GLOBAL ""^addr(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("addr_charmulti","text",0)="CREATE TABLE `addr_charmulti` (`id` INTEGER CONSTRAINT ""addr_charmulti_pkey"" PRIMARY KEY, `street` VARCHAR(40) DELIMS ($CHAR(124,124),""~~"") PIECES (2,1)) GLOBAL ""^addrm(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("addr_deep","text",0)="CREATE TABLE `addr_deep` (`id` INTEGER CONSTRAINT ""addr_deep_pkey"" PRIMARY KEY, `p3` VARCHAR(40) DELIMS (""|"",""^"",""~"") PIECES (2,2,2), `p4` VARCHAR(40) DELIMS (""|"",""^"",""~"","":"") PIECES (2,2,2,3)) GLOBAL ""^addrdeep(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("addr_multichar","text",0)="CREATE TABLE `addr_multichar` (`id` INTEGER CONSTRAINT ""addr_multichar_pkey"" PRIMARY KEY, `street` VARCHAR(40) DELIMS (""||"",""~~"") PIECES (2,1), `city` VARCHAR(40) DELIMS (""||"",""~~"") PIECES (2,3)) GLOBAL ""^addrm(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("addr_squote","text",0)="CREATE TABLE `addr_squote` (`id` INTEGER CONSTRAINT ""addr_squote_pkey"" PRIMARY KEY, `street` VARCHAR(40) DELIMS (""|"",""^"") PIECES (2,1)) GLOBAL ""^addr(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("downgrade_col","text",0)="CREATE TABLE `downgrade_col` (`id` INTEGER CONSTRAINT ""downgrade_col_pkey"" PRIMARY KEY, `fn` VARCHAR(40) DELIM ""|"" PIECE 1, `ln` VARCHAR(40) DELIM ""|"" PIECE 2, `extra` VARCHAR(40) PIECE 1) GLOBAL ""^dgrade(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("downgrade_col_plain","text",0)="CREATE TABLE `downgrade_col_plain` (`id` INTEGER CONSTRAINT ""downgrade_col_plain_pkey"" PRIMARY KEY, `fn` VARCHAR(40) DELIM ""|"" PIECE 1, `ln` VARCHAR(40) DELIM ""|"" PIECE 2, `extra` VARCHAR(40) PIECE 1) GLOBAL ""^dgrade(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("downgrade_empty","text",0)="CREATE TABLE `downgrade_empty` (`id` INTEGER CONSTRAINT ""downgrade_empty_pkey"" PRIMARY KEY, `whole` VARCHAR(40) DELIM """") GLOBAL ""^dgrade(keys(""""id""""))"" DELIM ""|"" READWRITE;"
^%ydboctoschema("downgrade_empty_plain","text",0)="CREATE TABLE `downgrade_empty_plain` (`id` INTEGER CONSTRAINT ""downgrade_empty_plain_pkey"" PRIMARY KEY, `whole` VARCHAR(40) DELIM """") GLOBAL ""^dgrade(keys(""""id""""))"" DELIM ""|"" READWRITE;"
