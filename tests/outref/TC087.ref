^%ydboctoschema("subtyp","text",0)="CREATE TABLE `subtyp` (`id` INTEGER CONSTRAINT ""subtyp_pkey"" PRIMARY KEY, `dob` DATE PIECE 1 SUBSTR 1-10, `flag` BOOLEAN PIECE 2 SUBSTR 2-4, `qty` INTEGER PIECE 3 SUBSTR 4-5) GLOBAL ""^subtyp(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("subtypx","text",0)="CREATE TABLE `subtypx` (`id` INTEGER CONSTRAINT ""subtypx_pkey"" PRIMARY KEY, `inum` INTEGER PIECE 1 SUBSTR 1-2, `inum_p` INTEGER PIECE 1, `dec` NUMERIC PIECE 2 SUBSTR 1-4, `flag` BOOLEAN PIECE 3 SUBSTR 1-1, `flag_p` BOOLEAN PIECE 3, `dt` DATE PIECE 4 SUBSTR 1-10) GLOBAL ""^subtypx(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("subval","text",0)="CREATE TABLE `subval` (`id` INTEGER CONSTRAINT ""subval_pkey"" PRIMARY KEY, `address` VARCHAR SUBSTR 1-12 GLOBAL ""^subval(keys(""""id""""),0)"" DELIM """", `addr_upper` VARCHAR EXTRACT ""$ZCONVERT(values(""""address""""),""""U"""")"") GLOBAL ""^subval(keys(""""id""""))"" DELIM ""|"" READONLY AIMTYPE 1;"
^%ydboctoschema("subval2","text",0)="CREATE TABLE `subval2` (`id` INTEGER CONSTRAINT ""subval2_pkey"" PRIMARY KEY, `birthyear` INTEGER PIECE 2 SUBSTR 1-4, `century` VARCHAR EXTRACT ""$EXTRACT(values(""""birthyear""""),1,2)"") GLOBAL ""^subval2(keys(""""id""""))"" DELIM ""|"" READONLY;"
^%ydboctoschema("subwn","text",0)="CREATE TABLE `subwn` (`id` INTEGER CONSTRAINT ""subwn_pkey"" PRIMARY KEY, `name` VARCHAR PIECE 1, `address` VARCHAR SUBSTR 1-12 GLOBAL ""^subwn(keys(""""id""""),0)"" DELIM """", `initial` VARCHAR SUBSTR 1 GLOBAL ""^subwn(keys(""""id""""),0)"" DELIM """") GLOBAL ""^subwn(keys(""""id""""))"" DELIM ""|"" READONLY AIMTYPE 1;"
