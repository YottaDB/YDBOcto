[ERROR]: ERR_SUBSTR_DELIM_WITHOUT_PIECE: SUBSTR keyword on column "v" with a non-empty DELIM/DELIMS requires a PIECE/PIECES specification
LINE 18:1: ...R SUBSTR 1-2 DELIMS ("|","^") GLOBAL "^subwn(keys(""id""),0)") ...
                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
OCTO> CREATE TABLE err_delims (id INTEGER PRIMARY KEY, v VARCHAR SUBSTR 1-2 DELIMS ("|","^") GLOBAL "^subwn(keys(""id""),0)") GLOBAL "^subwn(keys(""id""))";
[ERROR]: ERR_READWRITE_DISALLOWED: READWRITE keyword in CREATE TABLE is disallowed due to an incompatible keyword
OCTO> CREATE TABLE err_rw (id INTEGER PRIMARY KEY, v VARCHAR SUBSTR 1-2 GLOBAL "^subwn(keys(""id""),0)") GLOBAL "^subwn(keys(""id""))" READWRITE;
