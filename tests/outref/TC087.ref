	address VARCHAR SUBSTR 1-12 GLOBAL "^subwn(keys(""id""),0)",
	initial VARCHAR SUBSTR 1 GLOBAL "^subwn(keys(""id""),0)"
) GLOBAL "^subwn(keys(""id""))" AIMTYPE 1;
CREATE TABLE
