	id INTEGER PRIMARY KEY,
	dob DATE PIECE 1 SUBSTR 1-10,
	flag BOOLEAN PIECE 2 SUBSTR 2-4,
	qty INTEGER PIECE 3 SUBSTR 4-5
) GLOBAL "^subtyp(keys(""id""))";
CREATE TABLE
