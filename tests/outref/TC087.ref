	birthyear INTEGER PIECE 2 SUBSTR 1-4,
	birthday VARCHAR PIECE 2 SUBSTR 9-10,
	idnum INTEGER PIECE 3 SUBSTR 2-5
) GLOBAL "^subpc(keys(""id""))";
CREATE TABLE
