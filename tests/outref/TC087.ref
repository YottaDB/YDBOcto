# Generated $EXTRACT calls (SUBSTR codegen -- Sections A-C):
$EXTRACT($EXTRACT($PIECE($GET(^subval2(%ydboctocursor(cursorId,"keys",1,"subval2","id"))),"|",2),1,4),1,2)
$EXTRACT($GET(^subval(%ydboctocursor(cursorId,"keys",1,"subval","id"),0)),1,12)
$EXTRACT($GET(^subval(%ydboctocursor(cursorId,"keys",1,"subval","id"),0)),1,12),"U")
$EXTRACT($GET(^subwn(%ydboctocursor(cursorId,"keys",1,"subwn","id"),0)),1)
$EXTRACT($GET(^subwn(%ydboctocursor(cursorId,"keys",1,"subwn","id"),0)),1,12)
