	head3	VARCHAR DELIMS ("|","^") PIECES (2,1) SUBSTR 1-3,
	char4	VARCHAR DELIMS ("|","^") PIECES (2,1) SUBSTR 4-4
) GLOBAL "^u3(keys(""id""))" READONLY;
CREATE TABLE
OCTO> select label, head3, char4 from u3 order by label;
label|head3|char4
ascii|abc|d
cjk|日本語|
mixed|Xé日|Y
(3 rows)
OCTO> select label from u3 where head3 = 'Xé日';
label
mixed
(1 row)
OCTO> 

# Generated $EXTRACT calls:
$EXTRACT($GET(^u2(%ydboctocursor(cursorId,"keys",1,"u2","id"),0)),1,3)
$EXTRACT($GET(^u2(%ydboctocursor(cursorId,"keys",1,"u2","id"),0)),4,4)
$EXTRACT($PIECE($GET(^u1(%ydboctocursor(cursorId,"keys",1,"u1","id"))),"|",1),1)
$EXTRACT($PIECE($GET(^u1(%ydboctocursor(cursorId,"keys",1,"u1","id"))),"|",1),1,3)
$EXTRACT($PIECE($GET(^u1(%ydboctocursor(cursorId,"keys",1,"u1","id"))),"|",1),1,3)),%ydboctocursor(cursorId,"keys",3,"",""))=%ydboctoexpr
$EXTRACT($PIECE($GET(^u1(%ydboctocursor(cursorId,"keys",1,"u1","id"))),"|",1),2,3)
$EXTRACT($PIECE($GET(^u1(%ydboctocursor(cursorId,"keys",1,"u1","id"))),"|",1),4,4)
$EXTRACT($PIECE($PIECE($GET(^u3(%ydboctocursor(cursorId,"keys",1,"u3","id"))),"|",2),"^",1),1,3)
$EXTRACT($PIECE($PIECE($GET(^u3(%ydboctocursor(cursorId,"keys",1,"u3","id"))),"|",2),"^",1),4,4)
