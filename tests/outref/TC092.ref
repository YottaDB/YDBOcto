# Stage 1 : Load ^GCND (the table data)
#           Expect : 3 rows, with first subscripts 1, 2 and the non-numeric A9
# yottadb -run %XCMD 'zwrite ^GCND'
^GCND(1,"A")="OPEN`x"
^GCND(2,"A")="CLOSED`y"
^GCND("A9","A")="PAST END`z"

# Stage 2 : CREATE TABLE episodes with END "'+keys(...)" and episodes2 with the
#           parenthesized form END "'+(keys(...))", and query both
#           Expect     : both CREATE TABLEs succeed and both queries return the same 2 rows,
#                        1|OPEN and 2|CLOSED. The A9 row is past the END so it is not returned
#           Previously : the episodes query failed with
#                        %YDB-E-LVUNDEF, Undefined local variable: keys("internal_episode_record_no")
#                        while episodes2 returned the 2 rows
# octo -p -f TC092.sql
-- TC092 : OCTO1116 : keys() in an END is expanded when it follows an M operator

-- "episodes" places keys("internal_episode_record_no") after the "+" of the END expression
-- "'+keys(...)", i.e. stop the scan at the first subscript that is not numeric. Before YDBOcto#1149
-- a keys() was expanded only when it was preceded by "(" or ",", so this reference was emitted as is
-- and the query failed with
-- %YDB-E-LVUNDEF, Undefined local variable: keys("internal_episode_record_no").
-- "episodes2" is the same END written as "'+(keys(...))". That form was already expanded before
-- YDBOcto#1149 (it was the workaround reported in the issue) and must keep working. Both tables
-- must return the same rows.
DROP TABLE IF EXISTS episodes;
CREATE TABLE episodes (
	internal_episode_record_no varchar(20) END "'+keys(""internal_episode_record_no"")",
	episode_status varchar(10) PIECE 1,
	PRIMARY KEY (internal_episode_record_no)
) GLOBAL "^GCND(keys(""internal_episode_record_no""),""A"")" DELIM "`" READONLY;
DROP TABLE IF EXISTS episodes2;
CREATE TABLE episodes2 (
	internal_episode_record_no varchar(20) END "'+(keys(""internal_episode_record_no""))",
	episode_status varchar(10) PIECE 1,
	PRIMARY KEY (internal_episode_record_no)
) GLOBAL "^GCND(keys(""internal_episode_record_no""),""A"")" DELIM "`" READONLY;

select * from episodes;
select * from episodes2;
OCTO> DROP TABLE IF EXISTS episodes;
DROP TABLE
OCTO> CREATE TABLE episodes (
	internal_episode_record_no varchar(20) END "'+keys(""internal_episode_record_no"")",
	episode_status varchar(10) PIECE 1,
	PRIMARY KEY (internal_episode_record_no)
) GLOBAL "^GCND(keys(""internal_episode_record_no""),""A"")" DELIM "`" READONLY;
CREATE TABLE
OCTO> DROP TABLE IF EXISTS episodes2;
DROP TABLE
OCTO> CREATE TABLE episodes2 (
	internal_episode_record_no varchar(20) END "'+(keys(""internal_episode_record_no""))",
	episode_status varchar(10) PIECE 1,
	PRIMARY KEY (internal_episode_record_no)
) GLOBAL "^GCND(keys(""internal_episode_record_no""),""A"")" DELIM "`" READONLY;
CREATE TABLE
OCTO> select * from episodes;
internal_episode_record_no|episode_status
1|OPEN
2|CLOSED
(2 rows)
OCTO> select * from episodes2;
internal_episode_record_no|episode_status
1|OPEN
2|CLOSED
(2 rows)
OCTO> 

# Stage 3 : Look for keys("internal_episode_record_no") left as is in the generated M plans
#           Expect     : no output, i.e. the reference was expanded into %ydboctocursor(...)
#           Previously : the reference that followed the "+" was listed here
# grep -hoaE '(^|[^(,])keys\("internal_episode_record_no"\)' _ydboctoP*.m | sort -u

# Stage 4 : CREATE TABLE with a misspelled column name in an END keys() that follows a "+"
#           Expect     : CREATE TABLE fails with ERR_UNKNOWN_COLUMN_NAME naming the
#                        misspelled column internal_episode_record
#           Previously : the reference was not matched, so it was never validated. The
#                        CREATE TABLE was accepted and the typo surfaced at query time
# octo -p -f TC092_errors.sql

-- TC092 : OCTO1116 : a misspelled column name in an END keys() that follows an M operator is caught
--                    at CREATE TABLE time

-- "validate_start_end_keyword.c" validates the END string with the same "match_expression()" used to
-- generate the plan. Before YDBOcto#1149 a keys() that followed "+" was not matched, hence never
-- validated, so the CREATE TABLE below was accepted and the misspelled column name surfaced at query
-- time as %YDB-E-LVUNDEF, Undefined local variable: keys("internal_episode_record").
-- It must now fail at CREATE TABLE time with ERR_UNKNOWN_COLUMN_NAME.
DROP TABLE IF EXISTS badend;
CREATE TABLE badend (
	internal_episode_record_no varchar(20) END "'+keys(""internal_episode_record"")",
	PRIMARY KEY (internal_episode_record_no)
) GLOBAL "^GCND(keys(""internal_episode_record_no""),""A"")" DELIM "`" READONLY;
OCTO> DROP TABLE IF EXISTS badend;
DROP TABLE
[ERROR]: ERR_UNKNOWN_COLUMN_NAME: Unknown column: internal_episode_record
OCTO> CREATE TABLE badend (
	internal_episode_record_no varchar(20) END "'+keys(""internal_episode_record"")",
	PRIMARY KEY (internal_episode_record_no)
) GLOBAL "^GCND(keys(""internal_episode_record_no""),""A"")" DELIM "`" READONLY;
OCTO> 
