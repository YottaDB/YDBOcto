CHECK (CASE WHEN (a = 'Zero') THEN b WHEN (a = 'One') THEN FALSE ELSE TRUE END))
CHECK ((CASE n WHEN 1 THEN n WHEN 2 THEN 0 ELSE 1 END > 0))
