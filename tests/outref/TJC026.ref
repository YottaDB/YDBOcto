
-- TJC026 : OCTO1127 : Bind parameters whose value is NULL (JDBC "setNull()")
-- Before YDBOcto#1127, every prepared statement with a setNull() parameter failed at the Bind message with
--   ERROR: Bind: invalid number of result column format codes: -256 is out of range (min: 0, max: 32767)
-- as rocto misread the Bind message after the NULL value (length -1, no value bytes). This test verifies that reads and
-- writes with setNull() parameters now work, that the parameter is SQL NULL (not an empty string), and that a text value
-- followed by a NULL value is stored exactly.

CREATE TABLE TJC026 (id INTEGER PRIMARY KEY, val INTEGER, name VARCHAR) GLOBAL "^TJC026";
INSERT INTO TJC026 VALUES (1, 10, 'PAT'), (2, 20, 'PATIENT'), (3, NULL, NULL);
SELECT * FROM TJC026 ORDER BY id;
OCTO> CREATE TABLE TJC026 (id INTEGER PRIMARY KEY, val INTEGER, name VARCHAR) GLOBAL "^TJC026";
CREATE TABLE
OCTO> INSERT INTO TJC026 VALUES (1, 10, 'PAT'), (2, 20, 'PATIENT'), (3, NULL, NULL);
INSERT 0 3
OCTO> SELECT * FROM TJC026 ORDER BY id;
id|val|name
1|10|PAT
2|20|PATIENT
3||
(3 rows)
OCTO> 

# Run TJC026.java. Each statement binds at least one parameter with setNull(). Before YDBOcto#1127, each one
# failed with the [invalid number of result column format codes: -256] error described above.
INSERT INTO TJC026 (id, val) VALUES (4, setNull(INTEGER))
  1 row(s) affected
INSERT INTO TJC026 (id, val, name) VALUES (5, setNull(INTEGER), 'five')
  1 row(s) affected
INSERT INTO TJC026 (id, name, val) VALUES (6, 'six', setNull(INTEGER))
  1 row(s) affected
SELECT id, '[' || name || ']', name = 'six' FROM TJC026 WHERE id = 6
  6|[six]|t
UPDATE TJC026 SET name = setNull(VARCHAR) WHERE id = 1
  1 row(s) affected
SELECT * FROM TJC026 ORDER BY id
  1|10|NULL
  2|20|PATIENT
  3|NULL|NULL
  4|NULL|NULL
  5|NULL|five
  6|NULL|six
SELECT setNull(VARCHAR) IS NULL
  t
SELECT COALESCE(setNull(VARCHAR), 'was NULL')
  was NULL
# Before YDBOcto#1127, each query below failed at Bind. Now each one runs, and returns no rows, as a
# comparison with NULL is never true (on a key column, a non-key column, and in a LIKE).
SELECT id FROM TJC026 WHERE id = setNull(INTEGER) (key column)
  (0 rows)
SELECT id FROM TJC026 WHERE val = setNull(INTEGER) (non-key column)
  (0 rows)
SELECT id FROM TJC026 WHERE name LIKE setNull(VARCHAR)
  (0 rows)
# The same prepared statement bound to NULL, then to 'PAT%': the NULL of the first Bind does not stick.
# Row 1's name was set to NULL by the UPDATE above, so only row 2 matches 'PAT%'.
SELECT id FROM TJC026 WHERE name LIKE setNull(VARCHAR) ORDER BY id
  (0 rows)
SELECT id FROM TJC026 WHERE name LIKE 'PAT%' ORDER BY id
  2
