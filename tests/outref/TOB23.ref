# Verify ORDER BY optimization took effect (i.e. ORDER BY got removed) from queries where applicable
# [no sort] : the plan has no OrderBy step, i.e. the rows come out of the key FOR loops in ORDER BY order
# [sort]    : the plan still collects and sorts the rows in an OrderBy step
[no sort] : select * from TOB23 where test_code = 'PSA' order by isn
[no sort] : select * from TOB23 where test_code = 'PSA' order by isn desc limit 1
[no sort] : select * from TOB23 where test_code = 'PSA' order by test_code desc, isn desc limit 2
[no sort] : select * from TOB23_boolean where k1 = false order by k1 desc, k2
[no sort] : select * from TOB23_boolean where k1 = true order by k2
[no sort] : select * from TOB23_boolean where k1 = true order by k2 desc limit 2
