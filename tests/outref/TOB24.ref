[no sort] : select n1.id, n2.lastname, n2.id from names n1, names n2 where n1.id = 2 order by n2.lastname desc, n2.id
[sort]    : select * from TOB24b order by n, code
[sort]    : select * from TOB24c order by n, d
[sort]    : select * from TOB24d order by last, id
[sort]    : select * from TOB24k_varchar order by v desc, k desc limit 3
[sort]    : select * from TOB24k_varchar order by v, k
[sort]    : select * from TOB24r_time order by v, k
[sort]    : select * from TOB24r_timestamp order by v, k
[sort]    : select * from TOB24r_timestamptz order by v, k
[sort]    : select * from TOB24r_timetz order by v, k
[sort]    : select * from names order by lastname, firstname
[sort]    : select * from names order by lastname, id, firstname
[sort]    : select * from names order by lastname, names.*
[sort]    : select * from names order by names.*
[sort]    : select * from names where firstname = 'Zero' order by lastname, id
[sort]    : select * from names where id > 1 order by lastname, id
[sort]    : select id, i from TOB24h order by i desc, id
[sort]    : select id, i from TOB24h order by i, id
[sort]    : select id, i from TOB24h where i > 0 order by i desc, id
[sort]    : select id, n from TOB24h order by n desc, id
[sort]    : select id, n from TOB24h order by n, id
[sort]    : select lastname, count(*) from names group by lastname order by lastname
[sort]    : select n1.id, n2.lastname from names n1 right join names n2 on n1.id = n2.id order by n2.lastname, n2.id
[sort]    : select name from pg_catalog.pg_settings order by setting limit 0
# likeprefixend^%ydboctoplanhelpers (start of a descending LIKE prefix walk): "Ze" gives "Zf". A last byte of
# 255 is dropped and the byte before it is incremented ("A"_$ZCHAR(255,255) gives "B"). An empty prefix or one
# of only bytes of 255 gives "" (start at the end of the cross reference). Values are shown between [ and ].
[Zf]
[B]
[]
[]
# Run octo -vv on TOB24_vv.sql. Below each query are the lines of its logical plans that mark the key that walks a
# cross reference for the ORDER BY [order_by_xref_walk: true] and a key walked in descending order [desc: true].

-- TOB24 : OCTO1160 : -vv shows which LP_KEY walks an ORDER BY column ("order_by_xref_walk: true") and which LP_KEY walks
-- in descending order ("desc: true"). Each query selects "id, lastname", which no other TOB24 query does, so that it gets
-- a new plan whose logical plan -vv shows.

-- Cross reference walk of lastname, ascending and descending
select id, lastname from names order by lastname, id limit 1;
select id, lastname from names order by lastname desc, id desc limit 1;
-- Primary key FOR loop in descending order (YDBOcto#959)
select id, lastname from names order by id desc limit 1;
-- Cross reference that the WHERE fixes to a range, walked in descending order
select id, lastname from names where lastname > 'C' order by lastname desc, id;
-- Not optimized: no key shows either line
select id, lastname from names order by lastname, firstname limit 1;
OCTO> select id, lastname from names order by lastname, id limit 1;
          - order_by_xref_walk: true
OCTO> select id, lastname from names order by lastname desc, id desc limit 1;
          - order_by_xref_walk: true
          - desc: true
            - desc: true
OCTO> select id, lastname from names order by id desc limit 1;
          - desc: true
OCTO> select id, lastname from names where lastname > 'C' order by lastname desc, id;
          - desc: true
OCTO> select id, lastname from names order by lastname, firstname limit 1;
