# Verify ORDER BY optimization took effect (i.e. ORDER BY got removed) from queries where applicable
# [no sort] : the plan has no OrderBy step, i.e. the rows come out of the cross reference walk in ORDER BY order
# [sort]    : the plan still collects and sorts the rows in an OrderBy step
[no sort] : select * from TOB24a order by b desc, id
[no sort] : select * from TOB24a order by b, id
[no sort] : select * from TOB24a order by d desc, id
[no sort] : select * from TOB24a order by d, id
[no sort] : select * from TOB24a order by i desc, id
[no sort] : select * from TOB24a order by i, id
