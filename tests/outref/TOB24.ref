[no sort] : select * from TOB24a order by n, id
[no sort] : select * from TOB24a order by s desc, id
[no sort] : select * from TOB24a order by s, id
[no sort] : select * from TOB24a where i > 0 order by i desc, id
[no sort] : select * from TOB24a where n <= 1.5 order by n desc, id
[no sort] : select * from TOB24a where s > '1' order by s desc, id
[no sort] : select * from TOB24e order by d desc, id
[no sort] : select * from TOB24e order by d, id
[no sort] : select * from TOB24f order by v desc, id limit 4
