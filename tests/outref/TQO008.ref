
-- TQO008 : #1141 : Only comparison operators are accepted inside OPERATOR(); anything else is a syntax error
-- Octo supports only the OPERATOR() form of the comparison operators. Arithmetic, string concatenation and the
-- pattern matching operators are deliberately not supported in this form, so each query below is expected to
-- fail with a syntax error that points at the offending operator.

select id from names where id operator(pg_catalog.+) 1 = 4;
select id from names where id operator(pg_catalog.-) 1 = 2;
select id from names where id operator(pg_catalog.*) 1 = 3;
select id from names where id operator(pg_catalog./) 1 = 3;
select id from names where id operator(pg_catalog.%) 2 = 1;
select firstname from names where firstname operator(pg_catalog.||) 'x' = 'Zerox';
select firstname from names where firstname operator(pg_catalog.~~) 'Zero';
select firstname from names where firstname operator(pg_catalog.!~~) 'Zero';
select firstname from names where firstname operator(pg_catalog.~) 'Zero';
select firstname from names where firstname operator(pg_catalog.!~) 'Zero';
select id from names where id operator() 3;
select id from names where id operator(pg_catalog.) 3;
select id from names where id operator(pg_catalog.pg_class.=) 3;
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected PLUS
LINE 3:1: select id from names where id operator(pg_catalog.+) 1 = 4;
                                                            ^
OCTO> select id from names where id operator(pg_catalog.+) 1 = 4;
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected MINUS
LINE 4:1: select id from names where id operator(pg_catalog.-) 1 = 2;
                                                            ^
OCTO> select id from names where id operator(pg_catalog.-) 1 = 2;
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected ASTERISK
LINE 5:1: select id from names where id operator(pg_catalog.*) 1 = 3;
                                                            ^
OCTO> select id from names where id operator(pg_catalog.*) 1 = 3;
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected SOLIDUS
LINE 6:1: select id from names where id operator(pg_catalog./) 1 = 3;
                                                            ^
OCTO> select id from names where id operator(pg_catalog./) 1 = 3;
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected PERCENT
LINE 7:1: select id from names where id operator(pg_catalog.%) 2 = 1;
                                                            ^
OCTO> select id from names where id operator(pg_catalog.%) 2 = 1;
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected PIPE
LINE 8:1: ...om names where firstname operator(pg_catalog.||) 'x' = 'Zerox';
                                                          ^
OCTO> select firstname from names where firstname operator(pg_catalog.||) 'x' = 'Zerox';
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected TILDE
LINE 9:1: ...name from names where firstname operator(pg_catalog.~~) 'Zero';
                                                                 ^
OCTO> select firstname from names where firstname operator(pg_catalog.~~) 'Zero';
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected EXCLAMATION
LINE 10:1: ...ame from names where firstname operator(pg_catalog.!~~) 'Zero';
                                                                 ^
OCTO> select firstname from names where firstname operator(pg_catalog.!~~) 'Zero';
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected TILDE
LINE 11:1: ...tname from names where firstname operator(pg_catalog.~) 'Zero';
                                                                   ^
OCTO> select firstname from names where firstname operator(pg_catalog.~) 'Zero';
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected EXCLAMATION
LINE 12:1: ...name from names where firstname operator(pg_catalog.!~) 'Zero';
                                                                  ^
OCTO> select firstname from names where firstname operator(pg_catalog.!~) 'Zero';
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected RIGHT_PAREN
LINE 13:1: select id from names where id operator() 3;
                                                  ^
OCTO> select id from names where id operator() 3;
[ERROR]: ERR_PARSE_FAILED: syntax error, unexpected RIGHT_PAREN
