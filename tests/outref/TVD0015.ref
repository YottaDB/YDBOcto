OCTO> 
# Read-side $EXTRACT emitted for LOCK_TEMPLATE:
$EXTRACT($GET(^XLM(8993,%ydboctocursor(cursorId,"keys",1,"xulm_lock_dictionary","xulm_lock_dictionary_id"),0)),1,245)
# AIM transformation function emitted for LOCK_TEMPLATE:
SubstrXform^%ydboctoplanhelpers(,""1-245"",""s"")
