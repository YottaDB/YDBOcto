-- ############################################################################################################
-- Part L: two of the plans above
# -vv: 2 key_column_xref marker(s) in the logical plan of: SELECT val FROM gxrf WHERE id = 76;
# The FOR loop of the range walk of (Part A): SELECT * FROM gxrf WHERE id > 76 LIMIT 2;
# Expected: its QUIT tests %ydboctozlimit, so the walk ends at the LIMIT.
    IF '$ZYISSQLNULL(%ydboctozkeyfix(1,0)) FOR  SET %ydboctozkeyfix(1,0)=$ORDER(^%ydbAIMS<hash>(3,%ydboctozkeyfix(1,0))) QUIT:(%ydboctozkeyfix(1,0)="")!(%ydboctozkeyfix(1,0)="")!($GET(%ydboctocursor(cursorId,"parameters",2))'>%ydboctozlimit(3))  DO

