CREATE TABLE itrv (a INTEGER ITERATOR "$$a^TWO21" VIRTUAL, b INTEGER ITERATOR "$$b^TWO21", v VARCHAR PIECE 1,
  PRIMARY KEY (a, b)) GLOBAL "^ITR(keys(""a""),keys(""b""))";
CREATE TABLE

