OCTO> -- TWO22 : YDBOcto#1177 : a key column fixed by = or IN stays inside the bounds of its START, STARTINCLUDE and
-- ENDPOINT keywords, as the table scan and the range (<, >, <=, >=) walks already do. START is exclusive unless
-- STARTINCLUDE is given; ENDPOINT is inclusive. Every answer below must agree with the table scan of its part.

-- ############################################################################################################
-- Part A: an INTEGER key, START 0 ENDPOINT 5. The rows are the subscripts 1 through 5: 3 and 5.
SELECT XECUTE_M_CODE('zwrite ^TWO22a');
^TWO22a(0)="zero"
^TWO22a(3)="three"
^TWO22a(5)="five"
^TWO22a(6)="six"
xecute_m_code
0
(1 row)
OCTO> CREATE TABLE two22a (k INTEGER PRIMARY KEY START 0 ENDPOINT 5, v VARCHAR PIECE 1) GLOBAL "^TWO22a(keys(""k""))" READONLY;
CREATE TABLE
OCTO> -- the table scan: 3 and 5
SELECT * FROM two22a ORDER BY k;
k|v
3|three
5|five
(2 rows)
OCTO> -- no row: 0 is START, which is exclusive
SELECT * FROM two22a WHERE k = 0;
k|v
(0 rows)
OCTO> -- 5: ENDPOINT is inclusive
SELECT * FROM two22a WHERE k = 5;
k|v
5|five
(1 row)
OCTO> -- no row: 6 is past ENDPOINT
SELECT * FROM two22a WHERE k = 6;
k|v
(0 rows)
OCTO> -- 3 and 5
SELECT * FROM two22a WHERE k IN (0, 3, 5, 6);
k|v
3|three
5|five
(2 rows)
OCTO> -- the ranges, for comparison: 3 and 5
SELECT * FROM two22a WHERE k >= 0 ORDER BY k;
k|v
3|three
5|five
(2 rows)
OCTO> SELECT * FROM two22a WHERE k <= 6 ORDER BY k;
k|v
3|three
5|five
(2 rows)
OCTO> -- ############################################################################################################
-- Part B: the same global with STARTINCLUDE: 0 is a row.
CREATE TABLE two22b (k INTEGER PRIMARY KEY START 0 ENDPOINT 5 STARTINCLUDE, v VARCHAR PIECE 1) GLOBAL "^TWO22a(keys(""k""))" READONLY;
CREATE TABLE
OCTO> -- the table scan: 0, 3 and 5
SELECT * FROM two22b ORDER BY k;
k|v
0|zero
3|three
5|five
(3 rows)
OCTO> -- 0
SELECT * FROM two22b WHERE k = 0;
k|v
0|zero
(1 row)
OCTO> -- no row: 6 is past ENDPOINT
SELECT * FROM two22b WHERE k = 6;
k|v
(0 rows)
OCTO> -- 0 and 5
SELECT * FROM two22b WHERE k IN (0, 5, 6);
k|v
0|zero
5|five
(2 rows)
OCTO> -- ############################################################################################################
-- Part C: a VARCHAR key, START '"d"' ENDPOINT '"h"', compared as strings. The rows are e and h.
SELECT XECUTE_M_CODE('zwrite ^TWO22c');
^TWO22c("b")="bee"
^TWO22c("d")="dee"
^TWO22c("e")="ee"
^TWO22c("h")="aitch"
^TWO22c("k")="kay"
xecute_m_code
0
(1 row)
OCTO> CREATE TABLE two22c (k VARCHAR PRIMARY KEY START '"d"' ENDPOINT '"h"', v VARCHAR PIECE 1) GLOBAL "^TWO22c(keys(""k""))" READONLY;
CREATE TABLE
OCTO> -- the table scan: e and h
SELECT * FROM two22c ORDER BY k;
k|v
e|ee
h|aitch
(2 rows)
OCTO> -- no row: d is START
SELECT * FROM two22c WHERE k = 'd';
k|v
(0 rows)
OCTO> -- h: ENDPOINT is inclusive
SELECT * FROM two22c WHERE k = 'h';
k|v
h|aitch
(1 row)
OCTO> -- no row: k is past ENDPOINT
SELECT * FROM two22c WHERE k = 'k';
k|v
(0 rows)
OCTO> -- e and h
SELECT * FROM two22c WHERE k IN ('b', 'd', 'e', 'h', 'k');
k|v
e|ee
h|aitch
(2 rows)
OCTO> -- the range, for comparison: e and h
SELECT * FROM two22c WHERE k >= 'a' ORDER BY k;
k|v
e|ee
h|aitch
(2 rows)
OCTO> -- ############################################################################################################
-- Part D: the same global with STARTINCLUDE: d is a row.
CREATE TABLE two22d (k VARCHAR PRIMARY KEY START '"d"' ENDPOINT '"h"' STARTINCLUDE, v VARCHAR PIECE 1) GLOBAL "^TWO22c(keys(""k""))" READONLY;
CREATE TABLE
OCTO> -- the table scan: d, e and h
SELECT * FROM two22d ORDER BY k;
k|v
d|dee
e|ee
h|aitch
(3 rows)
OCTO> -- d
SELECT * FROM two22d WHERE k = 'd';
k|v
d|dee
(1 row)
OCTO> -- no row: b is below START
SELECT * FROM two22d WHERE k = 'b';
k|v
(0 rows)
OCTO> -- d and h
SELECT * FROM two22d WHERE k IN ('b', 'd', 'h', 'k');
k|v
d|dee
h|aitch
(2 rows)
OCTO> -- the range, for comparison: d, e and h
SELECT * FROM two22d WHERE k >= 'a' ORDER BY k;
k|v
d|dee
e|ee
h|aitch
(3 rows)
OCTO> -- ############################################################################################################
-- Part E: a composite key (g, k), k START 0 ENDPOINT 5, with g fixed, so that k is fixed in place under it.
SELECT XECUTE_M_CODE('zwrite ^TWO22e');
^TWO22e(1,0)="zero"
^TWO22e(1,3)="three"
^TWO22e(2,3)="three b"
^TWO22e(2,5)="five"
^TWO22e(2,6)="six"
xecute_m_code
0
(1 row)
OCTO> CREATE TABLE two22e (g INTEGER KEY NUM 0, k INTEGER KEY NUM 1 START 0 ENDPOINT 5, v VARCHAR PIECE 1) GLOBAL "^TWO22e(keys(""g""),keys(""k""))" READONLY;
CREATE TABLE
OCTO> -- the table scan: 1|3, 2|3 and 2|5
SELECT * FROM two22e ORDER BY g, k;
g|k|v
1|3|three
2|3|three b
2|5|five
(3 rows)
OCTO> -- no row: 0 is START
SELECT * FROM two22e WHERE g = 1 AND k = 0;
g|k|v
(0 rows)
OCTO> -- no row: 6 is past ENDPOINT
SELECT * FROM two22e WHERE g = 2 AND k = 6;
g|k|v
(0 rows)
OCTO> -- 2|3 and 2|5
SELECT * FROM two22e WHERE g = 2 AND k IN (0, 3, 5, 6);
g|k|v
2|3|three b
2|5|five
(2 rows)
OCTO> -- ############################################################################################################
-- Part F: END, a condition that ends the table scan: here, at the first subscript that is not a number. The rows
-- are 1, 5 and 8; the scan stops at a, so neither a nor b is a row.
SELECT XECUTE_M_CODE('zwrite ^TWO22f');
^TWO22f(1)="one"
^TWO22f(5)="five"
^TWO22f(8)="eight"
^TWO22f("a")="ay"
^TWO22f("b")="bee"
xecute_m_code
0
(1 row)
OCTO> CREATE TABLE two22f (k VARCHAR PRIMARY KEY END "'+keys(""k"")", v VARCHAR PIECE 1) GLOBAL "^TWO22f(keys(""k""))" READONLY;
CREATE TABLE
OCTO> -- the table scan: 1, 5 and 8
SELECT * FROM two22f ORDER BY k;
k|v
1|one
5|five
8|eight
(3 rows)
OCTO> -- 5
SELECT * FROM two22f WHERE k = '5';
k|v
5|five
(1 row)
OCTO> -- no row: END is true at a
SELECT * FROM two22f WHERE k = 'a';
k|v
(0 rows)
OCTO> -- 1 and 8
SELECT * FROM two22f WHERE k IN ('1', '8', 'b');
k|v
1|one
8|eight
(2 rows)
OCTO> -- ############################################################################################################
-- Part G: a NUMERIC key, START 1.5 ENDPOINT 7.25: the bounds are compared as numbers. The rows are 2 and 7.25.
SELECT XECUTE_M_CODE('zwrite ^TWO22g');
^TWO22g(1.5)="one and a half"
^TWO22g(2)="two"
^TWO22g(7.25)="seven and a quarter"
^TWO22g(9)="nine"
xecute_m_code
0
(1 row)
OCTO> CREATE TABLE two22g (k NUMERIC PRIMARY KEY START 1.5 ENDPOINT 7.25, v VARCHAR PIECE 1) GLOBAL "^TWO22g(keys(""k""))" READONLY;
CREATE TABLE
OCTO> -- the table scan: 2 and 7.25
SELECT * FROM two22g ORDER BY k;
k|v
2|two
7.25|seven and a quarter
(2 rows)
OCTO> -- no row: 1.5 is START
SELECT * FROM two22g WHERE k = 1.5;
k|v
(0 rows)
OCTO> -- 7.25: ENDPOINT is inclusive
SELECT * FROM two22g WHERE k = 7.25;
k|v
7.25|seven and a quarter
(1 row)
OCTO> -- no row: 9 is past ENDPOINT
SELECT * FROM two22g WHERE k = 9;
k|v
(0 rows)
OCTO> -- 2 and 7.25
SELECT * FROM two22g WHERE k IN (1.5, 2, 7.25, 9);
k|v
2|two
7.25|seven and a quarter
(2 rows)
OCTO> -- ############################################################################################################
-- Part H: both key columns bounded, g START 1 ENDPOINT 2 and k START 0 ENDPOINT 5, and both fixed: each key is
-- tested against its own bounds inside its own DO. The only row is 2|3.
SELECT XECUTE_M_CODE('zwrite ^TWO22h');
^TWO22h(1,3)="a"
^TWO22h(2,0)="b"
^TWO22h(2,3)="c"
^TWO22h(2,6)="d"
^TWO22h(3,3)="e"
xecute_m_code
0
(1 row)
OCTO> CREATE TABLE two22h (g INTEGER KEY NUM 0 START 1 ENDPOINT 2, k INTEGER KEY NUM 1 START 0 ENDPOINT 5, v VARCHAR PIECE 1)
  GLOBAL "^TWO22h(keys(""g""),keys(""k""))" READONLY;
CREATE TABLE
OCTO> -- the table scan: 2|3
SELECT * FROM two22h ORDER BY g, k;
g|k|v
2|3|c
(1 row)
OCTO> -- no row: 1 is g's START
SELECT * FROM two22h WHERE g = 1 AND k = 3;
g|k|v
(0 rows)
OCTO> -- no row: 3 is past g's ENDPOINT
SELECT * FROM two22h WHERE g = 3 AND k = 3;
g|k|v
(0 rows)
OCTO> -- no row: 0 is k's START
SELECT * FROM two22h WHERE g = 2 AND k = 0;
g|k|v
(0 rows)
OCTO> -- 2|3
SELECT * FROM two22h WHERE g = 2 AND k = 3;
g|k|v
2|3|c
(1 row)
OCTO> -- 2|3: g's IN is tested against g's bounds, k's IN against k's
SELECT * FROM two22h WHERE g IN (1, 2, 3) AND k IN (0, 3, 6);
g|k|v
2|3|c
(1 row)
OCTO> 

# The bound tests emitted for a key fixed by = or IN: a dotted QUIT per bound (START, ENDPOINT, END), against the key's own value.
# (A range walk tests %ydboctozkeyfix instead, in lines that are not listed here.)
QUIT:"d"]%ydboctocursor(cursorId,"keys",1,"two22d","k")
QUIT:%ydboctocursor(cursorId,"keys",1,"two22a","k")<=0
QUIT:%ydboctocursor(cursorId,"keys",1,"two22a","k")]]5
QUIT:%ydboctocursor(cursorId,"keys",1,"two22b","k")<0
QUIT:%ydboctocursor(cursorId,"keys",1,"two22b","k")]]5
QUIT:%ydboctocursor(cursorId,"keys",1,"two22c","k")']"d"
QUIT:%ydboctocursor(cursorId,"keys",1,"two22c","k")]]"h"
QUIT:%ydboctocursor(cursorId,"keys",1,"two22d","k")]]"h"
QUIT:%ydboctocursor(cursorId,"keys",1,"two22e","k")<=0
QUIT:%ydboctocursor(cursorId,"keys",1,"two22e","k")]]5
QUIT:('+%ydboctocursor(cursorId,"keys",1,"two22f","k"))
QUIT:%ydboctocursor(cursorId,"keys",1,"two22g","k")<=1.5
QUIT:%ydboctocursor(cursorId,"keys",1,"two22g","k")]]7.25
QUIT:%ydboctocursor(cursorId,"keys",1,"two22h","g")<=1
QUIT:%ydboctocursor(cursorId,"keys",1,"two22h","g")]]2
QUIT:%ydboctocursor(cursorId,"keys",1,"two22h","k")<=0
QUIT:%ydboctocursor(cursorId,"keys",1,"two22h","k")]]5
