-- half with a NULL d1.v
-- [sort] the ORDER BY items are columns of two tables (d.v, then d1.v).
SELECT d.v, d1.v FROM TWO24d1 d1 RIGHT JOIN TWO24d d ON d1.k = d.k2 ORDER BY d.v, d1.v;
