^%ydbAIMDaNI3owDN2a9yHIfc0vPyE0(6)="+^ORD(sub1=100.01,sub2=0:,sub3=""VUID"") -command=set -name=%ydbaNI3owDN2a9yHIfc0vPyE0S -xecute=<<"_$C(10)_" ; type 4 value node SET: for each cross referenced piece i, p and q are the old and the new value of that piece"_$C(10)_" ; a changed piece moves the key's entry from p to q; an unchanged EMPTY piece is a node created with that piece empty, which makes the record's entry for it the empty string: no record side trigger fires for the value node, so that entry is made here"_$C(10)_"  for i=1 set p=""#""_$piece($ztoldval,""^"",i),q=""#""_$piece($ztvalue,""^"",i) do"_$C(10)_" . if p'=q zkill ^%ydbAIMDaNI3owDN2a9yHIfc0vPyE0(i,p,sub2) set ^%ydbAIMDaNI3owDN2a9yHIfc0vPyE0(i,q,sub2)="""""_$C(10)_" . ; p=q and empty: a node created with this piece empty; cross reference the key under the empty string"_$C(10)_" . else  set:q=""#"" ^%ydbAIMDaNI3owDN2a9yHIfc0vPyE0(i,""#"",sub2)="""""_$C(10)
^%ydbAIMDaNI3owDN2a9yHIfc0vPyE0(7)="+^ORD(sub1=100.01,sub2=0:,sub3=""VUID"") -command=kill -name=%ydbaNI3owDN2a9yHIfc0vPyE0K -xecute=<<"_$C(10)_" ; KILL: turn the KILL into ZKILLs, so that the ZKILL triggers retire the entries of every node that goes"_$C(10)_" ; a node with no children ($ZTDATA under 10) is ZKILLed outright; a subtree is walked depth first by dft"_$C(10)_"  if '($ztdata\10) set var=$reference zkill:$ztdata @var quit"_$C(10)_" do dft($reference) quit"_$C(10)_" ; never reached: keeps the label below inside the trigger code (YDB#799)"_$C(10)_" if ^%ydbAIMDaNI3owDN2a9yHIfc0vPyE0"_$C(10)_"dft(var)"_$C(10)_" ; depth first: recurse into each child that has children, ZKILL each that has none, then ZKILL the node itself"_$C(10)_" new sub,vard,vars,varsd,vsroot"_$C(10)_" set vard=$data(@var)"_$C(10)_" do:vard\10"_$C(10)_" . if $qlength(var) set vsroot=$zextract(var,1,$zlength(var)-1)_"","""_$C(10)_" . else  set vsroot=var_""("""_$C(10)_" . set vars=vsroot_""sub)"""_$C(10)_" . set sub="""" for  do  set sub=$order(@vars) quit:'$zlength(sub)"_$C(10)_" . . set varsd=$data(@vars)"_$C(10)_" . . if varsd\10 do dft(vsroot_$zwrite(sub)_"")"")"_$C(10)_" . . else  zkill:varsd#10 @(vsroot_$zwrite(sub)_"")"")"_$C(10)_" zkill:vard#10 @var"_$C(10)_" quit"_$C(10)
^%ydbAIMDaNI3owDN2a9yHIfc0vPyE0(8)="+^ORD(sub1=100.01,sub2=0:,sub3=""VUID"") -command=zkill -name=%ydbaNI3owDN2a9yHIfc0vPyE0Z -xecute=<<"_$C(10)_" ; type 4 value node ZKILL: for each cross referenced piece i, remove the key's entry for the value that is going; when a record survives (alive) the key is cross referenced under the empty string instead"_$C(10)_"  ; alive: a record survives this ZKILL - a node with a value at the record node or below it within the depth, not counting the node being removed, which is still there while the trigger runs"_$C(10)_" set alive=($data(^ORD(100.01,sub2))#10)&($name(^ORD(100.01,sub2))'=$name(^ORD(sub1,sub2,sub3))),rq=$name(^ORD(100.01,sub2)),rq=$zextract(rq,1,$zlength(rq)-1)_"","",rp=$query(^ORD(100.01,sub2)) for  quit:alive!($zextract(rp,1,$zlength(rq))'=rq)  set:($qlength(rp)'<2)&($qlength(rp)'>3)&(rp'=$name(^ORD(sub1,sub2,sub3))) alive=1 set:'alive rp=$query(@rp)"_$C(10)_"  for i=1 zkill ^%ydbAIMDaNI3owDN2a9yHIfc0vPyE0(i,""#""_$piece($ztoldval,""^"",i),sub2) set:alive ^%ydbAIMDaNI3owDN2a9yHIfc0vPyE0(i,""#"",sub2)="""""_$C(10)
