
# === Section A : WHERE / IS NULL on a 2-level string column (street) ===
# Data loaded into ^ppaddr:
^ppaddr(0)="Zero|123 Main^NYC|p0"
^ppaddr(1)="Acid|45 Oak^Boston|p1"
^ppaddr(2)="Lord|9 Elm^Reno|p2"
^ppaddr(3)="Neo|^Zion|p3"
-- ^ppaddr nodes are "name|street^city|phone"; street/city are extracted two levels deep.
-- Row id 3 ("Neo|^Zion|p3") has an EMPTY "^"-subpiece for street, so its street extracts to NULL.
CREATE TABLE ppaddr (
	id INTEGER PRIMARY KEY,
	street VARCHAR DELIMS ("|","^") PIECES (2,1),
	city VARCHAR DELIMS ("|","^") PIECES (2,2)
) GLOBAL "^ppaddr(keys(""id""))";
-- Extracted view (no conditions):
SELECT * FROM ppaddr ORDER BY id;
-- WHERE builds/uses the AIM cross-reference (expect id 1):
SELECT * FROM ppaddr WHERE street = '45 Oak';
-- Empty extracted subpiece -> NULL: IS NULL finds id 3, IS NOT NULL excludes it:
SELECT id, street, city FROM ppaddr WHERE street IS NULL;
SELECT id, street, city FROM ppaddr WHERE street IS NOT NULL ORDER BY id;
OCTO> CREATE TABLE ppaddr (
	id INTEGER PRIMARY KEY,
	street VARCHAR DELIMS ("|","^") PIECES (2,1),
	city VARCHAR DELIMS ("|","^") PIECES (2,2)
) GLOBAL "^ppaddr(keys(""id""))";
CREATE TABLE
OCTO> SELECT * FROM ppaddr ORDER BY id;
id|street|city
0|123 Main|NYC
1|45 Oak|Boston
2|9 Elm|Reno
3||Zion
(4 rows)
OCTO> SELECT * FROM ppaddr WHERE street = '45 Oak';
id|street|city
1|45 Oak|Boston
(1 row)
OCTO> SELECT id, street, city FROM ppaddr WHERE street IS NULL;
id|street|city
3||Zion
(1 row)
OCTO> SELECT id, street, city FROM ppaddr WHERE street IS NOT NULL ORDER BY id;
id|street|city
0|123 Main|NYC
1|45 Oak|Boston
2|9 Elm|Reno
(3 rows)
OCTO> 
# AIM index for street (subscript = full nested value, '#'-prefixed for string collation):
^%ydbAIMDe4NLPxAbRXsxWuKHa8eHL0(2,"#",3)=""
^%ydbAIMDe4NLPxAbRXsxWuKHa8eHL0(2,"#123 Main",0)=""
^%ydbAIMDe4NLPxAbRXsxWuKHa8eHL0(2,"#45 Oak",1)=""
^%ydbAIMDe4NLPxAbRXsxWuKHa8eHL0(2,"#9 Elm",2)=""
# The table is READONLY, so update the underlying global: ^ppaddr(1) '45 Oak' -> '999 New St'
-- Run after ^ppaddr(1) is updated directly (the table is READONLY). The AIM trigger re-derives the
-- chained value, so the index tracks the change: '45 Oak' is now gone and '999 New St' is found.
SELECT * FROM ppaddr WHERE street = '45 Oak';
SELECT * FROM ppaddr WHERE street = '999 New St';
OCTO> SELECT * FROM ppaddr WHERE street = '45 Oak';
