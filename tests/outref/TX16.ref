^%ydbAIMDIjIFVNhsDbRSrxSWHk1jJ1(0,"#Apple",1)=""
^%ydbAIMDIjIFVNhsDbRSrxSWHk1jJ1(0,"#Cherr",2)=""
^%ydbAIMDIjIFVNhsDbRSrxSWHk1jJ1(0,"#Mango",0)=""
