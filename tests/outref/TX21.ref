# zwrite ^ORD
^ORD(1)="Alice"
^ORD(1,1,0)="Widget"
^ORD(1,1,"SHIP")="Express"
^ORD(1,2,0)="Gadget"
^ORD(1,2,"SHIP")="Standard"
^ORD(2)="Bob"
^ORD(2,1,0)="Gizmo"
^ORD(3,1,0)="Sprocket"
^ORD(3,1,"SHIP")="Express"
OCTO> -- TX21 : YDBAIM#96 : a column whose GLOBAL maps a PARENT subscript of the primary key.

-- The primary key is (order_id, line_id), so a row is the pair (order_id, line_id). Each row's data
-- lives one level BELOW it, at ^ORD(order_id,line_id,<child>), exactly like the AIMTYPE documentation
-- example where ^EMP(emp_id,0) holds the department and ^EMP(emp_id,"EMAIL") holds the email:

--   * "item"        -> ^ORD(order_id,line_id,0)        : the row's main data (always present).
--   * "ship_method" -> ^ORD(order_id,line_id,"SHIP")   : a LOWER-level node keyed by the fixed
--                                                         subscript "SHIP" (same shape as "email").
--   * "customer"    -> ^ORD(order_id)                  : a HIGHER-level PARENT node, recorded once
--                                                         per order and shared by every line.

-- Two rows have a "missing node" SQL NULL:

--   * Row (2,1): ^ORD(2,1,"SHIP") is absent, so ship_method IS NULL.
--   * Row (3,1): ^ORD(3) is absent, so customer IS NULL.

-- A WHERE on a non-key column makes Octo build an AIM cross reference on that column, with the
-- table's own GLOBAL as the record specification, so a row is a row whether or not the column's
-- node exists. "customer" is the shape AIMTYPE 1 could not index at all: its global ^ORD(order_id)
-- has a single subscript, and type 1 needed at least two (%YDBAIM-F-NOSUBS). The AIMTYPE 1 in the
-- DDL below is accepted and ignored.
CREATE TABLE order_lines (
 order_id INTEGER,
 line_id INTEGER,
 customer VARCHAR(20) GLOBAL "^ORD(keys(""order_id""))" PIECE 1,
 item VARCHAR(20) GLOBAL "^ORD(keys(""order_id""),keys(""line_id""),0)" PIECE 1,
 ship_method VARCHAR(20) GLOBAL "^ORD(keys(""order_id""),keys(""line_id""),""SHIP"")" PIECE 1,
 PRIMARY KEY (order_id, line_id)
) GLOBAL "^ORD" AIMTYPE 1 DELIM "^" READONLY;
CREATE TABLE
OCTO> -- Unfiltered : all rows are present. Row (2,1) has an empty ship_method (^ORD(2,1,"SHIP") absent);
-- row (3,1) has an empty customer (parent node ^ORD(3) absent).
SELECT * FROM order_lines ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|1|Alice|Widget|Express
1|2|Alice|Gadget|Standard
2|1|Bob|Gizmo|
3|1||Sprocket|Express
(4 rows)
OCTO> -- WHERE on "ship_method" (a LOWER-level node with a fixed trailing subscript): returns row (2,1),
-- whose ship_method is a missing-node NULL.
SELECT * FROM order_lines WHERE ship_method IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
2|1|Bob|Gizmo|
(1 row)
OCTO> -- WHERE on "customer" (a PARENT node, a single subscript): returns row (3,1), whose customer is a
-- missing-node NULL.
SELECT * FROM order_lines WHERE customer IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
3|1||Sprocket|Express
(1 row)
OCTO> 

-- Re-asked after each change to ^ORD: the row universe as a full table scan sees it, then the
-- same table filtered through the cross reference of a column stored ABOVE the row and of one
-- stored below it. "customer" lives on ^ORD(order_id), one node shared by every line of an
-- order, so a single write to it has to move every row of that order at once.
-- The changes are made in M, as an application would (Octo never writes a READONLY table), so
-- from here on the triggers maintain the index, not the bulk build. A new line under an existing
-- order must also pick up a customer written before the line existed.
# A value appears on the parent node: every row of order 3 stops being a NULL customer.
# set ^ORD(3)="Carol"
OCTO> SELECT * FROM order_lines ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|1|Alice|Widget|Express
1|2|Alice|Gadget|Standard
2|1|Bob|Gizmo|
3|1|Carol|Sprocket|Express
(4 rows)
OCTO> SELECT * FROM order_lines WHERE customer IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
(0 rows)
OCTO> SELECT * FROM order_lines WHERE ship_method IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
2|1|Bob|Gizmo|
(1 row)
OCTO> 
# A new line under an existing order must inherit the customer written before it existed.
# set ^ORD(1,3,0)="Sprocket"
OCTO> SELECT * FROM order_lines ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|1|Alice|Widget|Express
1|2|Alice|Gadget|Standard
1|3|Alice|Sprocket|
2|1|Bob|Gizmo|
3|1|Carol|Sprocket|Express
(5 rows)
OCTO> SELECT * FROM order_lines WHERE customer IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
(0 rows)
OCTO> SELECT * FROM order_lines WHERE ship_method IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|3|Alice|Sprocket|
2|1|Bob|Gizmo|
(2 rows)
OCTO> 
# The parent value goes away: every row of order 1 becomes a NULL customer at once.
# zkill ^ORD(1)
OCTO> SELECT * FROM order_lines ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|1||Widget|Express
1|2||Gadget|Standard
1|3||Sprocket|
2|1|Bob|Gizmo|
3|1|Carol|Sprocket|Express
(5 rows)
OCTO> SELECT * FROM order_lines WHERE customer IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|1||Widget|Express
1|2||Gadget|Standard
1|3||Sprocket|
(3 rows)
OCTO> SELECT * FROM order_lines WHERE ship_method IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|3||Sprocket|
2|1|Bob|Gizmo|
(2 rows)
OCTO> 
# Value side, below the row: a missing-node NULL is given a value.
# set ^ORD(2,1,"SHIP")="Overnight"
OCTO> SELECT * FROM order_lines ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|1||Widget|Express
1|2||Gadget|Standard
1|3||Sprocket|
2|1|Bob|Gizmo|Overnight
3|1|Carol|Sprocket|Express
(5 rows)
OCTO> SELECT * FROM order_lines WHERE customer IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|1||Widget|Express
1|2||Gadget|Standard
1|3||Sprocket|
(3 rows)
OCTO> SELECT * FROM order_lines WHERE ship_method IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|3||Sprocket|
(1 row)
OCTO> 
# KILL of a whole order: its rows leave, and so does the parent value they shared.
# kill ^ORD(3)
OCTO> SELECT * FROM order_lines ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|1||Widget|Express
1|2||Gadget|Standard
1|3||Sprocket|
2|1|Bob|Gizmo|Overnight
(4 rows)
OCTO> SELECT * FROM order_lines WHERE customer IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|1||Widget|Express
1|2||Gadget|Standard
1|3||Sprocket|
(3 rows)
OCTO> SELECT * FROM order_lines WHERE ship_method IS NULL ORDER BY order_id, line_id;
order_id|line_id|customer|item|ship_method
1|3||Sprocket|
(1 row)
OCTO> 

# verify_aim_rebuild : 6 index entries maintained by the triggers, against a rebuild from scratch
# PASS : identical
