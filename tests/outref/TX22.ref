# KILL of a whole subtree rather than ZKILL of one node: the recursive-KILL triggers must decompose it.
# kill ^USER(3)
OCTO> SELECT * FROM users ORDER BY id;
id|name|email|dept
1|Alice|alice@example.com|
2|Bob|bob@example.com|
5|||Neurology
6|||
(4 rows)
