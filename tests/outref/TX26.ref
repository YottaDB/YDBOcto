^%ydbAIMDxm51YDQS3D1M1unpghmN7I(142)="+^G(sub1=*,sub2=*) -command=zkill -name=%ydbxm51YDQS3D1M1unpghmN7IZ1 -xecute=<<"_$C(10)_" ; type 4 record side ZKILL: when no record survives this node's removal (alive, below), retire the key's entries for every cross referenced piece"_$C(10)_"   ; alive: a record survives this ZKILL - a node with a value at the record node or below it within the depth, not counting the node being removed, which is still there while the trigger runs"_$C(10)_" set alive=0,rq=$name(^|""$PWD/yottadb.gld""|G(sub1)),rq=$zextract(rq,1,$zlength(rq)-1)_"","",rp=$query(^|""$PWD/yottadb.gld""|G(sub1)) for  quit:alive!($zextract(rp,1,$zlength(rq))'=rq)  set:($qlength(rp)'<2)&($qlength(rp)'>2)&(rp'=$name(^|""$PWD/yottadb.gld""|G(sub1,sub2))) alive=1 set:'alive rp=$query(@rp)"_$C(10)_"  if 'alive for i=1 zkill ^|""$PWD/extended.gld""|%ydbAIMDxm51YDQS3D1M1unpghmN7I(i,""#""_$piece($get(^|""$PWD/extended.gld""|H(sub1)),""^"",i),sub1)"_$C(10)
^%ydbAIMDxref("^H","^%ydbAIMDxm51YDQS3D1M1unpghmN7I")=""

# verify_aim_rebuild : 2 index entries maintained by the triggers, against a rebuild from scratch
# PASS : identical
