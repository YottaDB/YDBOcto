# TX28 : OCTO1167 : A query that follows a cross reference build that stopped on an error is not reported as canceled
# set ^TX28(1) to 1100 bytes, and ^TX28(2) to "b"
$zlength(^TX28(1))=1100
^TX28(2)="b"
OCTO> -- "v" of row 1 is 1100 bytes long, more than the subscripts of a node of the AIM region can hold. The WHERE below
-- builds the cross reference of "v", and the build stops with %YDB-E-GVSUBOFLOW at that row.
CREATE TABLE TX28 (id INTEGER PRIMARY KEY, v VARCHAR PIECE 1) GLOBAL "^TX28(keys(""id""))" READONLY;
CREATE TABLE
OCTO> SELECT id FROM TX28 WHERE v = 'b';
# The build of the cross reference stopped with: %YDB-E-GVSUBOFLOW
OCTO> -- The next query of the same session: both rows. Before the fix, it failed with
-- "ERR_QUERY_CANCELED: canceling statement due to user request".
SELECT id FROM TX28;
id
1
2
(2 rows)
OCTO> -- The next query ran normally before the fix.
SELECT id FROM TX28;
id
1
2
(2 rows)
OCTO> 
