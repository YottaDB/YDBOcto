 }

@test "TX10 : OCTO961 : Verify xref invalidation and re-generation" {
  echo "# 1st test which validates YDB instructions to re-sync cross refs" >> output.txt
  echo "# 1. Run SQL query that generates xref" >> output.txt
  octo <<OCTO 2>&1 | tee -a output.txt
SELECT * FROM names WHERE firstName = 'Zero';
OCTO
  echo "# 2. Verify xref is generated (i.e. cross reference ^%ydbAIMDERzGTIrQTVBoOhdanoKcC7 nodes for names table column firstname is present)" >> output.txt
  echo " --> ZWRITE ^names,^%ydbAIMD* before UNXREFDATA call" >> output.txt
  yottadb -run %XCMD 'zwrite ^names'  2>&1 | tee -a output.txt
  yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
  $ydb_dist/yottadb -run %XCMD 'zwr ^%ydbAIMOctoCache' >> output.txt
  $ydb_dist/yottadb -run %XCMD 'DO UNXREFDATA^%YDBAIM($QSUBSCRIPT(^%ydbAIMOctoCache("names","firstname","location"),0)) KILL ^%ydbAIMOctoCache("names","firstname")'
  echo " --> ZWRITE ^%ydbAIMD* after UNXREFDATA call. Verify that no output is recorded for this step. " >> output.txt
  yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
  echo "# 3. Re-Run SQL query to re-generate xref" >> output.txt
  octo <<OCTO 2>&1 | tee -a output.txt
SELECT * FROM names WHERE firstName = 'Zero';
OCTO
  echo "# 4. Verify xref (i.e. cross reference ^%ydbAIMDERzGTIrQTVBoOhdanoKcC7 nodes for names table column firstname) are re-generated" >> output.txt
  echo " --> ZWRITE ^%ydbAIMD* xref regeneration" >> output.txt
  yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
  $ydb_dist/yottadb -run %XCMD "zwr ^%ydbAIMOctoCache" >> output.txt || true
  verify_output TX10_1 output.txt
  mv output.txt output1.txt
  mv clean_output.txt clean_output1.txt
  echo "# 2nd test which validates DISCARD XREFS" >> output.txt
  echo "# 1. Add more xrefs (i.e. cross reference ^%ydbAIMDERzGTIrQTVBoOhdanoKcC7 nodes for names table column lastname)" >> output.txt
  echo "--> Adding lastname xref by running a query which makes use of the column" >> output.txt
  octo <<OCTO 2>&1 | tee -a output.txt
SELECT * FROM names WHERE lastname = 'Cool';
OCTO
  echo "# 2. Verify xref exists (i.e. cross reference ^%ydbAIMDERzGTIrQTVBoOhdanoKcC7 nodes for names table and columns firstname and lastname" >> output.txt
  echo " --> ZWRITE ^names,^%ydbAIMD* before DISCARD" >> output.txt
  yottadb -run %XCMD 'zwrite ^names'  2>&1 | tee -a output.txt
  yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
  $ydb_dist/yottadb -run %XCMD 'zwr ^%ydbAIMOctoCache' >> output.txt
  echo "# 3. Discard xrefs using Octo command" >> output.txt
  echo " --> DISCARD all xrefs" >> output.txt
  octo <<OCTO 2>&1 | tee -a output.txt
DISCARD XREFS;
OCTO
  echo "# 4. Verify all xrefs are deleted (i.e. no cross references are seen)" >> output.txt
  echo " --> ZWRITE ^%ydbAIMD* after DISCARD" >> output.txt
  yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
  echo "# 5. Re-Run SQL query to re-generate xrefs" >> output.txt
  octo <<OCTO 2>&1 | tee -a output.txt
SELECT * FROM names WHERE firstName = 'Zero';
SELECT * FROM names WHERE lastName = 'Cool';
OCTO
  echo "# 6. Verify xrefs (i.e. cross reference ^%ydbAIMDERzGTIrQTVBoOhdanoKcC7 nodes for names table and columns firstname and lastname) are re-generated" >> output.txt
  yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
  $ydb_dist/yottadb -run %XCMD "zwr ^%ydbAIMOctoCache" >> output.txt || true
  verify_output TX10_2 output.txt
  mv clean_output.txt clean_output2.txt
  load_fixture customers.sql
  load_fixture customers.zwr
  echo "# 3rd test which validates DISCARD XREFS table_name" >> output.txt
  echo "# 1. Run SQL query that generates xref for customers (names xrefs are already generated by previous test)" >> output.txt
  octo <<OCTO 2>&1 | tee -a output.txt
SELECT * FROM customers where first_name='George';
SELECT * FROM customers where last_name='Washington';
OCTO
  echo "# 2. Verify xref exists (i.e. cross reference ^%ydbAIMDERzGTIrQTVBoOhdanoKcC7 and ^%ydbAIMDYC1ZzbpHR6f2IPlJaI1tB7 nodes for names (columns firstname, lastname) and customers (columns first_name, last_name)" >> output.txt
  echo " --> ZWRITE ^names,^%ydbAIMD* before DISCARD" >> output.txt
  yottadb -run %XCMD 'zwrite ^names'  2>&1 | tee -a output.txt
  yottadb -run %XCMD 'zwrite ^customers'  2>&1 | tee -a output.txt
  yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
  $ydb_dist/yottadb -run %XCMD 'zwr ^%ydbAIMOctoCache' >> output.txt
  echo "# 3. Discard xrefs for table names using Octo command" >> output.txt
  octo <<OCTO 2>&1 | tee -a output.txt
DISCARD XREFS names;
OCTO
  echo "# 4. Verify xrefs belonging to only names table are deleted (i.e. no cross references are seen) and verify xrefs belonging to customers table are NOT deleted" >> output.txt
  echo " --> ZWRITE ^%ydbAIMD* after DISCARD" >> output.txt
  yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
  $ydb_dist/yottadb -run %XCMD 'zwr ^%ydbAIMOctoCache' >> output.txt
  echo "# 5. Re-Run SQL query to re-generate xrefs" >> output.txt
  octo <<OCTO 2>&1 | tee -a output.txt
SELECT * FROM names WHERE firstName = 'Zero';
SELECT * FROM names WHERE lastName = 'Cool';
OCTO
  echo "# 6. Verify xrefs (i.e. cross reference ^%ydbAIMDERzGTIrQTVBoOhdanoKcC7 nodes for names table and columns firstname and lastname) are re-generated" >> output.txt
  yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
  $ydb_dist/yottadb -run %XCMD "zwr ^%ydbAIMOctoCache" >> output.txt || true
  verify_output TX10_3 output.txt

}

@test "TX11 : OCTO961 : Verify DISCARD XREFS table_name error cases" {
	load_fixture TX11.sql subtest novv
	verify_output TX11 output.txt
}

@test "TX12 : AIM93 : Verify operation of Octo with Extended References" {
	echo "Test to verify using Octo with Extended References" | tee -a output.txt

	echo | tee -a output.txt
	echo "Remove names table from Octo, as we plan to add it, but to a different database" | tee -a output.txt
	octo <<OCTO 2>&1 | tee -a output.txt
DROP TABLE IF EXISTS names;
DROP TABLE IF EXISTS nameswithages;
OCTO

	echo | tee -a output.txt
	echo "Create extended reference database with GLD extended.gld & load names into it" | tee -a output.txt
	createdb 2 extended.gld
	load_fixture names.sql "" "" "" extended.gld
	load_fixture names.zwr "" "" "" extended.gld

	echo | tee -a output.txt
	echo "Set ^names(1) = \"Extended|Reference\"" | tee -a output.txt
	ydb_gbldir=extended.gld $ydb_dist/yottadb -run %XCMD 'set ^names(1)="Extended|Reference"'

	echo | tee -a output.txt
	echo "Run a couple of queries to verify functionality and create AIM index" | tee -a output.txt
	ydb_gbldir=yottadb.gld octo <<OCTO 2>&1 | tee -a output.txt
SELECT * FROM names;
SELECT * FROM names WHERE lastName='Reference';
OCTO

	echo | tee -a output.txt
	echo "AIM Data in local DB (should be empty): " | tee -a output.txt
	ydb_gbldir=yottadb.gld yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt

	echo | tee -a output.txt
	echo "AIM Data in Extended DB: " | tee -a output.txt
	ydb_gbldir=extended.gld yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt

	echo | tee -a output.txt
	echo -n "Octo Data in local DB: " | tee -a output.txt
	ydb_gbldir=yottadb.gld yottadb -run %XCMD 'if $data(^%ydboctoocto),$data(^%ydboctoschema),$data(^%ydboctoseed) write "...found"' | tee -a output.txt

	echo | tee -a output.txt
	echo -n "Octo Data in Extended DB (should be empty): " | tee -a output.txt
	ydb_gbldir=extended.gld yottadb -run %XCMD "if '\$data(^%ydboctoocto),'\$data(^%ydboctoschema),'\$data(^%ydboctoseed) write \"...not found\"" | tee -a output.txt

	echo | tee -a output.txt
	echo "Add ^names(10)=\"Claudius|Nero\" and verify it's in index" | tee -a output.txt
	ydb_gbldir=extended.gld $ydb_dist/yottadb -run %XCMD 'set ^names(10)="Claudius|Nero"'
	ydb_gbldir=yottadb.gld octo <<OCTO 2>&1 | tee -a output.txt
SELECT * FROM names;
SELECT * FROM names WHERE lastName='Nero';
OCTO

	echo | tee -a output.txt
	echo "Delete ^names(10) and verify it's gone" | tee -a output.txt
	ydb_gbldir=extended.gld $ydb_dist/yottadb -run %XCMD 'kill ^names(10)'
	ydb_gbldir=yottadb.gld octo <<OCTO 2>&1 | tee -a output.txt
SELECT * FROM names;
SELECT * FROM names WHERE lastName='Nero';
OCTO

	echo | tee -a output.txt
	echo "Verify that DROP TABLE works properly: " | tee -a output.txt
	echo "AIM Data before DROP TABLE: " | tee -a output.txt
	ydb_gbldir=extended.gld yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
	ydb_gbldir=yottadb.gld octo <<< 'DROP TABLE names;' | tee -a output.txt
	ydb_gbldir=yottadb.gld octo <<< 'DROP TABLE nameswithages;' | tee -a output.txt
	echo "AIM Data after DROP TABLE (should be empty): " | tee -a output.txt
	ydb_gbldir=extended.gld yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt

	echo | tee -a output.txt
	echo "Reload table and recreate index for next test (we just dropped the tables)" | tee -a output.txt
	load_fixture names.sql "" "" "" extended.gld
	load_fixture names.zwr "" "" "" extended.gld
	ydb_gbldir=yottadb.gld octo <<OCTO 2>&1 | tee -a output.txt
SELECT * FROM names;
SELECT * FROM names WHERE lastName='Zero';
OCTO

	echo | tee -a output.txt
	echo "Verify that DISCARD XREFS works properly" | tee -a output.txt
	echo "AIM Data before DISCARD XREFS: " | tee -a output.txt
	ydb_gbldir=extended.gld yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
	ydb_gbldir=yottadb.gld octo <<< 'DISCARD XREFS;' | tee -a output.txt
	echo "AIM Data after DISCARD XREFS (should be empty): " | tee -a output.txt
	ydb_gbldir=extended.gld yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt

	verify_output TX12 output.txt
}

@test "TX14 : OCTO1128 : ZYSQLNULLNOTVALID error from EXTRACT column on the NULL side of a LEFT JOIN" {
	load_fixture TX14.zwr
	load_fixture TX14.sql subtest novv
	# Capture the generated octoLeftJoin code so the materialization of the "specnum" and "ext_specnum" columns is visible
	echo "" | tee -a output.txt
	echo "Excerpts of the generated M plan follow (octoLeftJoin code and the ^X(reg_num) column accesses)." | tee -a output.txt
	echo 'Non-key column names do not appear in generated M. The two piece-2 reads of ^X in table "results" are' | tee -a output.txt
	echo 'told apart by where the $SELECT($ZYISSQLNULL(<key lvn>):$ZYSQLNULL,1:...) guard sits relative to the $PIECE:' | tee -a output.txt
	echo '   specnum (GLOBAL/PIECE): guard is INSIDE $PIECE   -> $PIECE($SELECT($ZYISSQLNULL(<key lvn>):$ZYSQLNULL,1:$GET(^X(<key lvn>))),"|",2)' | tee -a output.txt
	echo '   ext_specnum (EXTRACT):  guard WRAPS the whole expr -> $SELECT($ZYISSQLNULL(<key lvn>):$ZYSQLNULL,1:$PIECE($GET(^X(<key lvn>)),"|",2))' | tee -a output.txt
	grep -hE 'octoLeftJoin|ZYSQLNULL|\^X\(' $(grep -l octoLeftJoin _ydboctoP*.m) >> output.txt
	verify_output TX14 output.txt
}

@test "TX15 : OCTO1108 : piece-of-piece (DELIMS/PIECES) AIM cross-reference" {
	# Section D (AIMTYPE 1) needs null subscripts disabled on the region (see TW28); Sections C and D
	# convert dates to unix-time, so fix TZ so those index values are deterministic. The whole test is
	# verified with "nodatetimefilter" so the literal dates are checked (not normalized to "DATE").
	# killAIMData^aimutils is called at each section boundary so every AIM index dump shows only the
	# tables created in that section.
	export TZ="UTC"
	load_fixture TX15.zwr

	# =====================================================================
	# Section A : 2-level string column -- SELECT *, WHERE, IS NULL, and the
	#             trigger-maintained index when the underlying global changes
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section A : WHERE / IS NULL on a 2-level string column (street) ===" | tee -a output.txt
	echo "# Data loaded into ^ppaddr:" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^ppaddr' 2>&1 | tee -a output.txt
	load_fixture TX15-A.sql subtest novv
	echo "# AIM index for street (subscript = full nested value, '#'-prefixed for string collation):" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(2,' | tee -a output.txt
	echo "# The table is READONLY, so change the underlying global directly. Both trigger paths:" | tee -a output.txt
	echo "#   SET   ^ppaddr(1) : street '45 Oak' -> '999 New St'" | tee -a output.txt
	echo "#   ZKILL ^ppaddr(2) : the whole row goes away, so street '9 Elm' is unindexed" | tee -a output.txt
	yottadb -run %XCMD 'set ^ppaddr(1)="Acid|999 New St^Boston|p1" zkill ^ppaddr(2)' 2>&1 | tee -a output.txt
	load_fixture TX15-A2.sql subtest novv
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(2,' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section B : MIN/MAX off the AIM index (string; 2-level and 3-level)
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section B : MIN/MAX off the AIM index (string; 2-level and 3-level) ===" | tee -a output.txt
	echo "# Data loaded into ^ppfruit and ^ppfruit3:" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^ppfruit,^ppfruit3' 2>&1 | tee -a output.txt
	load_fixture TX15-B.sql subtest novv
	echo "# AIM index for fruit (2-level table, then 3-level table):" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(2,' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section C : the transform composes the extraction with the column's own
	#             conversion -- DATE, BOOLEAN, INTEGER (2- and 3-level)
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section C : type conversions composed with the extraction (DATE / BOOLEAN / INTEGER) ===" | tee -a output.txt
	echo "# Data loaded into ^ppdt, ^ppdt3, ^ppflag, ^ppflag3, ^ppqty:" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^ppdt,^ppdt3,^ppflag,^ppflag3,^ppqty' 2>&1 | tee -a output.txt
	load_fixture TX15-C.sql subtest novv
	echo "# AIM index: date -> unix-time, boolean -> 0/1, integer -> raw number (all non-'#'):" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(2,' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section D : AIMTYPE 1 + DATE (AIM type 3) -- a missing source node is
	#             indexed as NULL (WHERE dob IS NULL finds it)
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section D : AIMTYPE 1 / type 3 -- missing source node indexed as NULL ===" | tee -a output.txt
	echo "# Data loaded into ^v3 and ^v33 (id 1 has no 'D' node, so its dob is a missing node):" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^v3,^v33' 2>&1 | tee -a output.txt
	load_fixture TX15-D.sql subtest novv
	echo "# AIM index for dob (the missing-node row id 1 is indexed as NULL):" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(2,' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section E : a 3-level column whose transform carries TWO outer levels
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section E : WHERE on a 3-level-deep piece-of-piece column ===" | tee -a output.txt
	echo "# Data loaded into ^ppv3:" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^ppv3' 2>&1 | tee -a output.txt
	load_fixture TX15-E.sql subtest novv
	echo "# AIM index for v (keyed on the fully extracted 3-level value):" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(2,' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section F : delimiter edge cases -- a $CHAR delimiter, and outer
	#             delimiters that are the spec's own separators (/ : .)
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section F : delimiter edge cases (\$CHAR delimiter; separators as delimiters) ===" | tee -a output.txt
	echo "# Data loaded into ^ppcaddr and ^ppsep:" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^ppcaddr,^ppsep' 2>&1 | tee -a output.txt
	load_fixture TX15-F.sql subtest novv
	echo "# The inner \$CHAR delimiter is emitted into XREFDATA verbatim as a \$CHAR() expression:" | tee -a output.txt
	grep -h 'XREFDATA^%YDBAIM' _ydboctoX*.m | grep -oE '[$]CHAR[(][0-9]+[)]' | sort -u | tee -a output.txt
	echo "# AIM index (ppcaddr keyed like the literal form; ppsep extracts 'Alpha'/'Beta' correctly):" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '\(2,"#' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section G : multi-byte UTF-8 delimiters (character / string / mix).
	#             A literal delimiter is byte-encoded into the AIM spec and
	#             rebuilt with $ZCHAR, so a multi-byte UTF-8 delimiter works.
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section G : multi-byte UTF-8 delimiters (char / string / char+ascii mix) ===" | tee -a output.txt
	# The multi-byte test data lives in TX15-G.zwr (a .zwr is exempt from the "no UTF-8 in source" pre-commit
	# check, unlike this .bats file). Dump it with zwrite, forcing UTF-8 for that one command so the raw
	# multi-byte characters render the same regardless of the random chset the rest of the subtest runs in
	# (an M-mode zwrite would byte-escape them). The SELECT values extracted below are ascii either way.
	load_fixture TX15-G.zwr
	echo "# Data loaded into ^ppu1 (char delim), ^ppu2 (string delim), ^ppu3 (char+ascii mix):" | tee -a output.txt
	env ydb_chset=UTF-8 ydb_routines="$ydb_dist/utf8/libyottadbutil.so" yottadb -run %XCMD 'zwrite ^ppu1,^ppu2,^ppu3' 2>&1 | tee -a output.txt
	load_fixture TX15-G.sql subtest novv
	echo "# AIM transform specs: a literal multi-byte delimiter is tagged Z (byte codes, rebuilt with \$ZCHAR):" | tee -a output.txt
	grep -hoE '"[0-9]+:[ZC][0-9.]+(/[0-9]+:[ZC][0-9.]+)*"' _ydboctoX*.m | sort -u | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section H : AIMTYPE 1 IS NULL matrix (all data types; no SUBSTR). Both
	#             NULL flavors -- a MISSING source node (id 2) and an EMPTY
	#             inner piece (id 3) -- index under the COLUMN'S OWN NULL
	#             marker, so every indexed IS NULL returns ids 2,3 and MIN/MAX
	#             skip both (YDBOcto#1108 fix, sharing the #763/#764 SUBSTR
	#             machinery). The marker is whatever the column's AIM transform
	#             maps "" to: "#" for a string column (strcolval2aimsubs) and a
	#             bare "" for DATE/BOOLEAN/INTEGER. AIM applies that same
	#             transform to a missing node's NULL, so a string
	#             column's two NULL flavors and a plain string column's NULL all
	#             collate on the one "#" marker the read side probes.
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section H : AIMTYPE 1 IS NULL matrix (missing node + empty piece, every type) ===" | tee -a output.txt
	echo "# ^ppnul id 2 is missing all typed nodes; id 3's inner pieces are all empty; both are NULL:" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^ppnul' 2>&1 | tee -a output.txt
	load_fixture TX15-H.sql subtest novv
	echo "# AIM index: SQL NULL (missing node AND empty piece) under the column's NULL marker -- '#' for VARCHAR, bare \"\" for DATE/BOOLEAN/INTEGER; real string values '#'-prefixed:" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(2,' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	verify_output TX15 output.txt nodatetimefilter noinfo nodebug
}

@test "TX16 : OCTO764 : SUBSTR AIM cross-reference" {
	# Tables whose SUBSTR columns read a node with a FIXED last subscript (e.g. ^gbl(id,0))
	# carry AIMTYPE 1: their xrefs then use AIM metadata type 3, which indexes a row
	# whose source node is MISSING as NULL, so indexed IS NULL lookups find such rows. AIM
	# applies the column's transformation function to that NULL, so the marker is
	# the transform of "" -- "#" for a string column (strcolval2aimsubs), a bare "" for
	# DATE/BOOLEAN/INTEGER. A present node whose SUBSTR extraction is empty lands on the same
	# marker, so both NULL flavors collate together and with a plain string column's NULL.
	# AIM only accepts type 3 for that shape and needs null subscripts
	# disabled on the region (see TX15/TW28). Section D converts a date to
	# unix time, so fix TZ so the indexed values are deterministic. The whole test is verified with
	# "nodatetimefilter" so the literal dates are checked (not normalized to "DATE").
	# killAIMData^aimutils is called at each section boundary so every AIM index dump shows only
	# the tables created in that section.
	# The AIM dump greps are anchored to the start of the data nodes (^%ydbAIMD*(pnum,...)):
	# AIM stores its trigger DEFINITIONS in the same global, and their -xecute bodies contain
	# "(0," so an unanchored grep would leak those (long, hash-named) lines into the output.
	export TZ="UTC"
	load_fixture TX16.zwr

	# =====================================================================
	# Section A : whole-node SUBSTR -- WHERE builds the index (empty separator,
	#             no piece number), and the trigger maintains it on SET/ZKILL
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section A : WHERE on a whole-node SUBSTR column (address) ===" | tee -a output.txt
	echo "# Data loaded into ^sxwn:" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^sxwn' 2>&1 | tee -a output.txt
	load_fixture TX16-A.sql subtest novv
	echo "# AIM index for address (pnum slot 0 = whole node; subscript = \$EXTRACT'ed value, '#'-prefixed):" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(0,' | tee -a output.txt
	echo "# The table is READONLY, so update the underlying global directly:" | tee -a output.txt
	echo "#   set ^sxwn(1,0)=\"999 New Street\" ; zkill ^sxwn(2,0)" | tee -a output.txt
	yottadb -run %XCMD 'set ^sxwn(1,0)="999 New Street" zkill ^sxwn(2,0)' 2>&1 | tee -a output.txt
	load_fixture TX16-A2.sql subtest novv
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(0,' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section B : MIN/MAX off the AIM index (whole-node and PIECE-based)
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section B : MIN/MAX off the AIM index (whole-node and PIECE-based) ===" | tee -a output.txt
	echo "# Data loaded into ^sxmm and ^sxmmp:" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^sxmm,^sxmmp' 2>&1 | tee -a output.txt
	load_fixture TX16-B.sql subtest novv
	echo "# AIM index for fruit (whole-node table, then PIECE-based table):" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\((0|2),' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section C : PIECE + SUBSTR -- AIM extracts the piece, SubstrXform slices it
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section C : WHERE on a PIECE + SUBSTR column (code) ===" | tee -a output.txt
	echo "# Data loaded into ^sxpc and ^sxpcg (^sxpcg id 2 is missing all data nodes; id 3's extractions are all empty):" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^sxpc,^sxpcg' 2>&1 | tee -a output.txt
	load_fixture TX16-C.sql subtest novv
	echo "# AIM index for code (subscript = chars 2-4 of piece 2, '#'-prefixed) and for the ^sxpcg" | tee -a output.txt
	echo "# columns (the AIMTYPE 1 NULL rows appear under the bare \"\" subscript):" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(2,' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section D : the transform composes the extraction with the column's own
	#             conversion -- DATE, BOOLEAN, INTEGER
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section D : type conversions composed with the extraction (DATE / BOOLEAN / INTEGER) ===" | tee -a output.txt
	echo "# Data loaded into ^sxdt, ^sxfl, ^sxqty, ^sxnul (^sxnul id 2 is missing all data nodes; id 3's extractions are all empty):" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^sxdt,^sxfl,^sxqty,^sxnul' 2>&1 | tee -a output.txt
	load_fixture TX16-D.sql subtest novv
	echo "# AIM index: date -> unix-time, boolean -> 0/1, integer -> raw number (all non-'#');" | tee -a output.txt
	echo "# the AIMTYPE 1 table's missing nodes appear under the bare \"\" subscript:" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\((0|2),' | tee -a output.txt
	yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

	# =====================================================================
	# Section E : DELIMS/PIECES + SUBSTR -- PieceOfPieceXform carries the SUBSTR
	#             specification as its trailing argument
	# =====================================================================
	echo "" | tee -a output.txt
	echo "# === Section E : WHERE on a DELIMS/PIECES + SUBSTR column (city3) ===" | tee -a output.txt
	echo "# Data loaded into ^sxpp and ^sxppg (^sxppg id 2 is missing all data nodes; id 3's pieces/ranges are empty):" | tee -a output.txt
	yottadb -run %XCMD 'zwrite ^sxpp,^sxppg' 2>&1 | tee -a output.txt
	load_fixture TX16-E.sql subtest novv
	echo "# AIM index for city3 (keyed on the \$EXTRACT of the innermost extracted piece):" | tee -a output.txt
	yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(2,' | tee -a output.txt

	# ---------------------------------------------------------------------
	# The XREFDATA call shapes over all sections: whole-node = empty separator +
	# empty piece slot; SubstrXform composes the conversion; PieceOfPieceXform
	# carries the SUBSTR spec as its trailing argument
	# ---------------------------------------------------------------------
	echo "" | tee -a output.txt
	echo "# Emitted XREFDATA calls (build entry point; one per xref'd SUBSTR column):" | tee -a output.txt
	grep -h 'SET aimglobal=\$\$XREFDATA' _ydboctoX*.m | grep ',0,0,1,0,' | sed 's/^[[:space:]]*//' | sort -u | tee -a output.txt

	verify_output TX16 output.txt nodatetimefilter noinfo nodebug

	# =====================================================================
	# Section F : multi-byte SUBSTR over the AIM index (UTF-8 only)
	# =====================================================================
	# TC088 (test_createtable3.bats.in) covers the READ side over multi-byte data; this covers
	# the INDEX side: AIM stores whatever SubstrXform returns, and that transform runs $EXTRACT
	# in the same process (hence the same chset) as the read side, so the two must agree on
	# character boundaries. Only observable under UTF-8, and "init_test" picks the chset at
	# random, so this section runs only on the UTF-8 runs and is verified against its own
	# TX16_utf8.ref; the M-mode runs stop at the TX16 verify_output above.
	if [[ $ydb_chset == "UTF-8" ]]; then
		# Resume from the already-verified output, and clear the AIM data and xref plans built by
		# Sections A-E: the "(1," dump and the SubstrXform grep below must show only ^ux.
		mv output.txt output_noutf8.txt
		yottadb -run killAIMData^aimutils
		rm -f _ydboctoX*.m _ydboctoX*.o

		# Built with $ZCHAR so this file stays pure ASCII (the pre-commit hook rejects UTF-8 in
		# source; the multi-byte literals compared against live in the .sql fixture).
		#   X=88  e-acute=195,169  CJK day=230,151,165  CJK book=230,156,172  CJK language=232,170,158  Y=89
		yottadb -run %XCMD 'set ^ux(1)=$ZCHAR(88,195,169,230,151,165,89)_"|mixed"'
		yottadb -run %XCMD 'set ^ux(2)=$ZCHAR(230,151,165,230,156,172,232,170,158)_"|cjk"'
		yottadb -run %XCMD 'set ^ux(3)="abcdef|ascii",^ux(4)="|empty"'

		echo "# Data loaded into ^ux (piece 1 is the value, piece 2 names the case):" | tee -a output.txt
		yottadb -run %XCMD 'zwrite ^ux' 2>&1 | tee -a output.txt
		load_fixture TX16-F.sql subtest novv

		# The indexed subscripts themselves: each is "#" followed by the first THREE CHARACTERS of
		# the value, so "mixed" indexes 7 bytes' worth of value as 3 characters. A byte-based
		# extraction would index a truncated (and invalid) UTF-8 sequence here instead.
		echo "" | tee -a output.txt
		echo "# AIM index subscripts (\"#\" + the 3-character extraction; NULL for the empty piece):" | tee -a output.txt
		yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(1,' | tee -a output.txt

		echo "" | tee -a output.txt
		echo "# The transformation function AIM was given for this column:" | tee -a output.txt
		grep -hoE 'SubstrXform\^%ydboctoplanhelpers[(],""[0-9-]*"",""[a-z]*""[)]' _ydboctoX*.m | sort -u | tee -a output.txt

		# Everything above exercised AIM's initial SCAN. The trigger path is separate code in
		# %YDBAIM and re-derives the value by calling SubstrXform itself, so change the underlying
		# global directly (the table is READONLY) and confirm the maintained index still lands on
		# character boundaries.
		echo "" | tee -a output.txt
		echo "# Trigger maintenance. Change the underlying global directly:" | tee -a output.txt
		echo "#   SET   ^ux(1) : the mixed-width value becomes three 3-byte characters" | tee -a output.txt
		echo "#   ZKILL ^ux(2) : the \"cjk\" row goes away" | tee -a output.txt
		# The replacement value is the 3-character place name written 230,157,177 / 228,186,172 /
		# 233,131,189 in UTF-8 (Tokyo Metropolis), so the extraction is 3 characters / 9 bytes.
		yottadb -run %XCMD 'set ^ux(1)=$ZCHAR(230,157,177,228,186,172,233,131,189)_"|mixed" zkill ^ux(2)'
		yottadb -run %XCMD 'zwrite ^ux' 2>&1 | tee -a output.txt
		load_fixture TX16-F2.sql subtest novv

		echo "" | tee -a output.txt
		echo "# AIM index after the trigger maintained it (3 characters again, not 3 bytes):" | tee -a output.txt
		yottadb -run zwriteAIMData^aimutils 2>&1 | grep -E '^\^%ydbAIMD[^(]*\(1,' | tee -a output.txt
		yottadb -run killAIMData^aimutils 2>&1 | tee -a output.txt

		verify_output TX16_utf8 output.txt noinfo nodebug
	fi
}

@test "TX21 : YDBAIM#96 : a column whose GLOBAL maps a parent subscript of the primary key" {
	load_fixture TX21.zwr
	# Show the data being mapped: "customer" is stored once per order on the parent node ^ORD(order_id);
	# each line item is a child node ^ORD(order_id,line_id).
	echo "# zwrite ^ORD" >> output.txt
	yottadb -run %XCMD 'zwrite ^ORD' 2>&1 | tee -a output.txt
	grep -v '^#' @PROJECT_SOURCE_DIR@/tests/fixtures/TX21.sql > TX21_input.sql
	octo -p -f TX21_input.sql 2>&1 | tee -a output.txt

	# The re-ask fixture's commentary goes into the output once; each step then runs only its queries
	echo "" >> output.txt
	grep '^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX21b.sql >> output.txt
	grep -v '^#\|^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX21b.sql > TX21b_input.sql
	tx21step() {	# $1 = M command to apply, $2 = what it demonstrates
		echo "# $2" >> output.txt
		echo "# $1" >> output.txt
		yottadb -run %XCMD "$1"
		octo -p -f TX21b_input.sql 2>&1 | tee -a output.txt
	}
	tx21step 'set ^ORD(3)="Carol"' \
		'A value appears on the parent node: every row of order 3 stops being a NULL customer.'
	tx21step 'set ^ORD(1,3,0)="Sprocket"' \
		'A new line under an existing order must inherit the customer written before it existed.'
	tx21step 'zkill ^ORD(1)' \
		'The parent value goes away: every row of order 1 becomes a NULL customer at once.'
	tx21step 'set ^ORD(2,1,"SHIP")="Overnight"' \
		'Value side, below the row: a missing-node NULL is given a value.'
	tx21step 'kill ^ORD(3)' \
		'KILL of a whole order: its rows leave, and so does the parent value they shared.'

	verify_aim_rebuild TX21b_input.sql

	verify_output TX21 output.txt
}

@test "TX22 : YDBAIM#96 : columns at more than one depth below the row" {
	load_fixture TX22.zwr
	# Show the data being mapped. Note id 4, whose only data is the value on the row node itself,
	# and id 1, the only row with a node at the depth "dept" is indexed at.
	echo "# zwrite ^USER" >> output.txt
	yottadb -run %XCMD 'zwrite ^USER' 2>&1 | tee -a output.txt
	grep -v '^#' @PROJECT_SOURCE_DIR@/tests/fixtures/TX22.sql > TX22_input.sql
	octo -p -f TX22_input.sql 2>&1 | tee -a output.txt

	# The re-ask fixture's commentary goes into the output once; each step then runs only its queries
	echo "" >> output.txt
	grep '^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX22b.sql >> output.txt
	grep -v '^#\|^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX22b.sql > TX22b_input.sql
	tx22step() {	# $1 = M command to apply, $2 = what it demonstrates
		echo "# $2" >> output.txt
		echo "# $1" >> output.txt
		yottadb -run %XCMD "$1"
		octo -p -f TX22b_input.sql 2>&1 | tee -a output.txt
	}
	tx22step 'set ^USER(5,1,"DEPT")="Neurology"' \
		'A new row whose ONLY node is TWO levels below the row - the deepest level the anchor spans.'
	tx22step 'set ^USER(2,"EMAIL")="bob@example.com"' \
		'Value side, one level down: a column that was a missing-node NULL is given a value.'
	tx22step 'zkill ^USER(1,1,"DEPT")' \
		'Value side, two levels down: the deepest column goes, but the row has other nodes and survives.'
	tx22step 'set ^USER(6)="Eve"' \
		'Row born by writing the ROW NODE itself, with no column nodes at all: a row, every column NULL.'
	tx22step 'zkill ^USER(4)' \
		'Row 4 was only ever a value on the row node. Take that away and the row goes with it.'
	tx22step 'kill ^USER(3)' \
		'KILL of a whole subtree rather than ZKILL of one node: the recursive-KILL triggers must decompose it.'

	verify_aim_rebuild TX22b_input.sql

	verify_output TX22 output.txt
}

@test "TX23 : YDBAIM#96 : a column stored at the row's own depth uses AIM type 0, and the scan agrees" {
	load_fixture TX23.zwr
	# Row (2,1) has no value of its own. It is in the tree only because of ^ORD(2,1,"NOTE"),
	# a node the table does not declare.
	echo "# zwrite ^ORD" >> output.txt
	yottadb -run %XCMD 'zwrite ^ORD' 2>&1 | tee -a output.txt
	grep -v '^#' @PROJECT_SOURCE_DIR@/tests/fixtures/TX23.sql > TX23_input.sql
	octo -p -f TX23_input.sql 2>&1 | tee -a output.txt

	# The re-ask fixture's commentary goes into the output once; each step then runs only its queries
	echo "" >> output.txt
	grep '^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX23b.sql >> output.txt
	grep -v '^#\|^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX23b.sql > TX23b_input.sql
	tx23step() {	# $1 = M command to apply, $2 = what it demonstrates
		echo "# $2" >> output.txt
		echo "# $1" >> output.txt
		yottadb -run %XCMD "$1"
		octo -p -f TX23b_input.sql 2>&1 | tee -a output.txt
	}
	tx23step 'set ^ORD(2,1)="Rewired^x"' \
		'(2,1) was not a row - it held no value. Give it one: it becomes a row in both.'
	tx23step 'set ^ORD(4,1)="^only-a-second-piece"' \
		'A new row whose PIECE 1 is empty. A missing PIECE of a node that exists is still NULL.'
	tx23step 'zkill ^ORD(1,1)' \
		'Take a row value away outright: the row leaves both.'
	tx23step 'set ^ORD(5,1,"NOTE")="undeclared node only"' \
		'An undeclared node and nothing else: a row in neither.'
	tx23step 'zkill ^ORD(2,1)' \
		'Value gone but the NOTE child remains, so the node is STILL in the tree - and stops being a row.'

	verify_aim_rebuild TX23b_input.sql

	verify_output TX23 output.txt
}

@test "TX24 : YDBAIM#96 : columns stored in a different global from the rows" {
	load_fixture TX24.zwr
	# Rows live in ^G; both columns live in ^H, so neither column global says which rows exist.
	echo "# zwrite ^G" >> output.txt
	yottadb -run %XCMD 'zwrite ^G' 2>&1 | tee -a output.txt
	echo "# zwrite ^H" >> output.txt
	yottadb -run %XCMD 'zwrite ^H' 2>&1 | tee -a output.txt
	grep -v '^#' @PROJECT_SOURCE_DIR@/tests/fixtures/TX24.sql > TX24_input.sql
	octo -p -f TX24_input.sql 2>&1 | tee -a output.txt

	# The re-ask fixture's commentary goes into the output once; each step then runs only its queries
	echo "" >> output.txt
	grep '^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX24b.sql >> output.txt
	grep -v '^#\|^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX24b.sql > TX24b_input.sql
	tx24step() {	# $1 = M command to apply, $2 = what it demonstrates
		echo "# $2" >> output.txt
		echo "# $1" >> output.txt
		yottadb -run %XCMD "$1"
		octo -p -f TX24b_input.sql 2>&1 | tee -a output.txt
	}
	tx24step 'set ^H(2)="Bob"' \
		'Value side, other global: order 2 stops being a NULL cust.'
	tx24step 'set ^G(2,2)="line"' \
		'Record side: a new row in ^G must pick up the cust that ^H already holds.'
	tx24step 'zkill ^H(1,1)' \
		'Value side at the row key depth: (1,1) loses its note but keeps existing.'
	tx24step 'zkill ^G(1,2)' \
		'Record side: the row goes away, so it must leave every index built on it.'
	tx24step 'set ^H(3,1)="orphan note"' \
		'A value in ^H with no row in ^G at all. Writing the column global must not invent a row.'

	verify_aim_rebuild TX24b_input.sql

	verify_output TX24 output.txt
}

@test "TX25 : YDBAIM#96 : a column with a transformation function (type=6)" {
	load_fixture TX25.zwr
	# id 3 has a value on the row node and no children, so there is no node at the indexed depth.
	echo "# zwrite ^EVT" >> output.txt
	yottadb -run %XCMD 'zwrite ^EVT' 2>&1 | tee -a output.txt
	grep -v '^#' @PROJECT_SOURCE_DIR@/tests/fixtures/TX25.sql > TX25_input.sql
	octo -p -f TX25_input.sql 2>&1 | tee -a output.txt

	# The re-ask fixture's commentary goes into the output once; each step then runs only its queries
	echo "" >> output.txt
	grep '^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX25b.sql >> output.txt
	grep -v '^#\|^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX25b.sql > TX25b_input.sql
	tx25step() {	# $1 = M command to apply, $2 = what it demonstrates
		echo "# $2" >> output.txt
		echo "# $1" >> output.txt
		yottadb -run %XCMD "$1"
		octo -p -f TX25b_input.sql 2>&1 | tee -a output.txt
	}
	tx25step 'set ^EVT(2,"ACT")="0"' \
		'A NULL becomes FALSE: the transform must run in the trigger, not just the scan.'
	tx25step 'set ^EVT(4,"ACT")="1"' \
		'A new row born by writing the transformed column itself.'
	tx25step 'zkill ^EVT(1,"ACT")' \
		'The transformed column goes but the row survives: back to NULL, not FALSE.'
	tx25step 'set ^EVT(3,"ACT")="not-a-boolean"' \
		'A value the transformation function has to normalize rather than index verbatim.'
	tx25step 'kill ^EVT(2)' \
		'KILL of a whole row: the recursive-KILL triggers must decompose it.'

	verify_aim_rebuild TX25b_input.sql

	verify_output TX25 output.txt
}

@test "TX26 : YDBAIM#96 : the rows and a column in different DATABASES" {
	# Rows in the LOCAL database; the "cust" column in an extended-reference database.
	# TX12 covers a table living entirely in an extended database - there one database holds
	# both the table and its cross reference. Here they are genuinely split, so the cross
	# reference has to reach across a database boundary in both directions.
	yottadb -run %XCMD 'set ^G(1,1)="line",^G(1,2)="line",^G(2,1)="line"'

	echo "# Create extended reference database extended.gld and put ^H into it" >> output.txt
	createdb 2 extended.gld
	ydb_gbldir=extended.gld yottadb -run %XCMD 'set ^H(1)="Alice"'

	echo "# zwrite ^G (local: the rows)" >> output.txt
	ydb_gbldir=yottadb.gld yottadb -run %XCMD 'zwrite ^G' 2>&1 | tee -a output.txt
	echo "# zwrite ^H (extended: the column; note there is no ^H(2))" >> output.txt
	ydb_gbldir=extended.gld yottadb -run %XCMD 'zwrite ^H' 2>&1 | tee -a output.txt

	grep -v '^#' @PROJECT_SOURCE_DIR@/tests/fixtures/TX26.sql > TX26_input.sql
	ydb_gbldir=yottadb.gld octo -p -f TX26_input.sql 2>&1 | tee -a output.txt

	# The re-ask fixture's commentary goes into the output once; each step then runs only its queries
	echo "" >> output.txt
	grep '^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX26b.sql >> output.txt
	grep -v '^#\|^--' @PROJECT_SOURCE_DIR@/tests/fixtures/TX26b.sql > TX26b_input.sql
	tx26step() {	# $1 = gld to apply the change under, $2 = M command, $3 = what it demonstrates
		echo "# $3" >> output.txt
		echo "# [$1] $2" >> output.txt
		ydb_gbldir=$1 yottadb -run %XCMD "$2"
		ydb_gbldir=yottadb.gld octo -p -f TX26b_input.sql 2>&1 | tee -a output.txt
	}
	tx26step extended.gld 'set ^H(2)="Bob"' \
		'Value side, in the OTHER database: order 2 stops being a NULL cust.'
	tx26step yottadb.gld 'set ^G(2,2)="line"' \
		'Record side, local: a new row must pick up the cust that only the other database holds.'
	tx26step extended.gld 'zkill ^H(1)' \
		'Value side, other database: both rows of order 1 become NULL cust at once.'
	tx26step yottadb.gld 'zkill ^G(1,1)' \
		'Record side, local: the row goes, and must leave an index that lives in the other database.'
	tx26step extended.gld 'set ^H(9)="Ghost"' \
		'A value in the other database with no row here at all: it must not invent a row.'

	echo "# AIM data in the LOCAL database" >> output.txt
	ydb_gbldir=yottadb.gld yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt
	echo "# AIM data in the EXTENDED database" >> output.txt
	ydb_gbldir=extended.gld yottadb -run zwriteAIMData^aimutils 2>&1 | tee -a output.txt

	ydb_gbldir=yottadb.gld verify_aim_rebuild TX26b_input.sql yottadb.gld extended.gld

	verify_output TX26 output.txt
}

@test "TX27 : YDBAIM#96 : a key fixed by the WHERE clause tests the row node as the scan does" {
	load_fixture TX27.zwr
	echo "# zwrite ^ORD,^GCND" >> output.txt
	yottadb -run %XCMD 'zwrite ^ORD,^GCND' 2>&1 | tee -a output.txt
	grep -v '^#' @PROJECT_SOURCE_DIR@/tests/fixtures/TX27.sql > TX27_input.sql
	octo -p -f TX27_input.sql 2>&1 | tee -a output.txt

	# The generated probes and guards of the row nodes, one line each: a key fixed by the WHERE
	# clause must test the full row node with "#10", as the scan's FOR loop does.
	echo "" >> output.txt
	echo "# row node tests in the generated plans" >> output.txt
	grep -h -E '\$DATA\(\^(ORD|GCND)\(' _ydboctoP*.m | sed 's/^[[:space:]]*//' | sort -u | tee -a output.txt

	verify_output TX27 output.txt
}
