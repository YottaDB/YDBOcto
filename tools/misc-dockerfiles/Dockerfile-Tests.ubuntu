#################################################################
# This file mirrors the pipeline set-up, but is not used by the
# pipeline. It lets you run the pipeline tests locally.
#
# Instructions:
# docker build -f tools/misc-dockerfiles/Dockerfile-Tests.ubuntu -t tests-ubuntu .
# docker run -it --rm tests-ubuntu
# OR docker run -it --rm tests-ubuntu "test-auto-upgrade" "debug" "52ba5a43" "display_relation_commands"
# OR docker run -it --rm tests-ubuntu "test-auto-upgrade" "debug" "52ba5a43" "ALL" (to run all auto-upgrade tests for a specific commit)
# OR docker run -it -v /tmp/myfolder:/octooutput --rm tests-ubuntu "test-auto-upgrade" "debug" "52ba5a43" "ALL" (keeps the tests output in /tmp/myfolder so that it can be examined)

FROM registry.gitlab.com/yottadb/dbms/ydbocto:ubuntu-master
ADD . /builds/YDBDBMS/
WORKDIR /builds/YDBDBMS
ENTRYPOINT ["tools/ci/build.sh"]
CMD ["make-ubuntu", "none"]
